---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Søg | Oratorium"
    description="Søg på tværs af Oratorium — bønner, helgener, ordbog, katekismus, apologetik og mere."
    bodyClass="selection:bg-gold-500/30 min-h-screen flex flex-col pt-32"
>
    <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage til Helligdommen</span>
        </a>
    </nav>

    <main data-pagefind-ignore class="max-w-2xl mx-auto px-6 pb-24 w-full">
        <header class="text-center mb-10">
            <i class="fa-solid fa-magnifying-glass text-gold-500 text-3xl mb-5" aria-hidden="true"></i>
            <h1 class="text-4xl md:text-5xl text-gold-300 font-serif mb-3 drop-shadow-[0_0_20px_rgba(212,175,55,0.2)]">Søg</h1>
            <p class="text-gray-400 sans text-sm">Find bønner, helgener, ord og svar på tværs af Oratorium.</p>
        </header>

        <div id="search" class="sans"></div>

        <noscript>
            <p class="text-center text-gray-500 sans text-sm mt-8">Søgning kræver JavaScript.</p>
        </noscript>
    </main>

    <style is:global>
        /* Theme the Pagefind UI to match the dark/gold aesthetic. */
        #search {
            --pagefind-ui-scale: 1;
            --pagefind-ui-primary: #d4af37;
            --pagefind-ui-text: #e5e7eb;
            --pagefind-ui-background: #0a0a0c;
            --pagefind-ui-border: rgba(255, 255, 255, 0.12);
            --pagefind-ui-tag: #15151a;
            --pagefind-ui-border-width: 1px;
            --pagefind-ui-border-radius: 8px;
            --pagefind-ui-font: 'Inter', sans-serif;
        }
        #search .pagefind-ui__result-title a { color: #f2e0a0; }
        #search .pagefind-ui__result-link { color: #f2e0a0; }
    </style>

    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            if (typeof PagefindUI === 'undefined') return;
            new PagefindUI({
                element: '#search',
                showSubResults: true,
                showImages: false,
                translations: {
                    placeholder: 'Søg på Oratorium…',
                    clear_search: 'Ryd',
                    load_more: 'Vis flere resultater',
                    search_label: 'Søg på sitet',
                    zero_results: 'Ingen resultater for [SEARCH_TERM]',
                    many_results: '[COUNT] resultater for [SEARCH_TERM]',
                    one_result: '[COUNT] resultat for [SEARCH_TERM]',
                    searching: 'Søger efter [SEARCH_TERM]…',
                },
            });
        });
    </script>
</Layout>
