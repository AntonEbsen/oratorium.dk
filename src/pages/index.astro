---
import Layout from '@layouts/Layout.astro';
import { getLiturgicalSeason } from '../utils/liturgy';
import { getDailyManna } from '../data/manna';

const dailyManna = getDailyManna();

// Liturgical Atmosphere
const season = getLiturgicalSeason(new Date());

const seasonGradients: Record<string, string> = {
    green:  'from-[#0a150a] via-black to-black', // Ordinary Time (Deep Green)
    purple: 'from-[#150515] via-black to-black', // Advent/Lent (Deep Purple)
    white:  'from-[#151205] via-black to-black', // Easter/Christmas (Deep Gold)
    red:    'from-[#150505] via-black to-black', // Pentecost/Martyrs (Deep Red)
    black:  'from-[#0a0a0a] via-black to-black'
};

// Default to green if undefined
const currentGradient = seasonGradients[season.color] || seasonGradients.green;

// Structured data for search engines (site identity).
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': 'https://oratorium.dk/#website',
            url: 'https://oratorium.dk/',
            name: 'Oratorium',
            description: 'Den Katolske Kirkes digitale forgård. Messetider, bønner, læring og fordybelse.',
            inLanguage: 'da-DK',
        },
        {
            '@type': 'Organization',
            '@id': 'https://oratorium.dk/#organization',
            name: 'Oratorium',
            url: 'https://oratorium.dk/',
            logo: 'https://oratorium.dk/assets/favicon-cross.svg',
        },
    ],
};
---

<Layout
    title="Ad Majorem Dei Gloriam ✝️ | Oratorium"
    description="Oratorium.dk – Den Katolske Kirkes digitale forgård. Find messetider, lær om troen, bed rosenkransen og find vejen hjem."
    bodyClass="bg-[#020205] text-white overflow-hidden h-screen w-screen m-0 p-0"
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)}></script>

    <!-- TOP BAR -->
    <div class="absolute top-0 w-full px-8 py-6 flex justify-between items-center z-50 pointer-events-none">

        <!-- ABOUT LINK (Top Left) -->
        <a href="/om" class="pointer-events-auto text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans group z-50">
            <i class="fa-solid fa-circle-info text-base group-hover:rotate-12 transition-transform" aria-hidden="true"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Om Oratorium</span>
        </a>

        <!-- Audio Control (Right) -->
        <button id="mute-btn" class="pointer-events-auto text-gold-500/60 hover:text-gold-400 transition-colors flex items-center gap-2 group" aria-label="Afspil eller sluk gregoriansk sang">
            <span class="text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity sans mr-2">Chant</span>
            <i class="fa-solid fa-volume-high group-hover:block hidden text-lg" aria-hidden="true"></i>
            <i class="fa-solid fa-volume-xmark group-hover:hidden block text-lg" aria-hidden="true"></i>
            <i class="fa-solid fa-play hidden text-gold-500 text-lg" aria-hidden="true"></i>
        </button>
    </div>

    <!-- MAIN CONTAINER -->
    <div class={`relative w-full h-full flex flex-col items-center justify-center font-serif text-center select-none overflow-hidden bg-gradient-to-b ${currentGradient} transition-colors duration-1000`}>

        <!-- Background FX -->
        <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png');"></div>
        <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden opacity-60 mix-blend-screen">
             <div class="absolute -bottom-20 left-1/4 w-[600px] h-[600px] bg-gray-600/20 rounded-full blur-[100px] animate-smoke-rise"></div>
             <div class="absolute -bottom-32 right-1/4 w-[700px] h-[700px] bg-gray-500/10 rounded-full blur-[120px] animate-smoke-rise-slow"></div>
             <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-gold-600/10 rounded-full blur-[80px] animate-pulse-slow"></div>
        </div>

        <!-- THE TRINITY LAYOUT (3 Columns) -->
        <div class="relative z-10 w-full max-w-7xl h-full flex flex-col md:flex-row pb-20 pt-20 px-4 md:px-12 gap-8 md:gap-12 justify-center items-center">

            <!-- COLUMN 1: THE CLOISTER (Mind & Study) -->
            <div class="flex-1 flex flex-col gap-6 items-center md:items-end text-right order-2 md:order-1 opacity-90 hover:opacity-100 transition-opacity">
                 <div class="text-[10px] uppercase tracking-[0.4em] text-gold-500/50 mb-2 border-b border-gold-900 pb-2 w-24 text-center md:text-right">Cloister</div>

                 <a href="/library" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Bibliotheca <i class="fa-solid fa-book ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/aquinas" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Summa Th. <i class="fa-solid fa-feather ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/lectio" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Lectio Divina <i class="fa-solid fa-comment-dots ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/scriptorium" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Scriptorium <i class="fa-solid fa-pen-nib ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/officium" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Officium <i class="fa-solid fa-hourglass-half ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/speculum" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Speculum <i class="fa-solid fa-moon ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/latina" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Schola Latina <i class="fa-solid fa-language ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/monasterium" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Monasterium <i class="fa-solid fa-chess-rook ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/scutum" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Scutum Fidei <i class="fa-solid fa-shield-halved ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
                 <a href="/saints" class="nav-link group">
                    <span class="group-hover:translate-x-[-5px] transition-transform block">Sanctorale <i class="fa-solid fa-crown ml-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i></span>
                 </a>
            </div>

            <!-- COLUMN 2: THE NAVE (Adoration & Worship) -->
            <div class="flex-initial w-full md:w-auto min-w-[300px] flex flex-col items-center gap-10 order-1 md:order-2 py-4">

                 <!-- The Monstrance (Centerpiece) -->
                 <div class="relative group cursor-pointer transform hover:scale-105 transition-transform duration-1000">
                    <a href="/adoration" class="block relative z-10 flex flex-col items-center gap-6" aria-label="Adoration — tilbedelse af det allerhelligste">
                        <div class="absolute inset-0 bg-gold-500/20 blur-[80px] rounded-full animate-pulse-slow"></div>
                         <svg width="100" height="140" viewBox="0 0 24 30" xmlns="http://www.w3.org/2000/svg" class="overflow-visible drop-shadow-[0_0_35px_rgba(255,215,0,0.6)]" aria-hidden="true">
                            <path d="M10 2 H14 V6 H22 V10 H14 V28 H10 V10 H2 V6 H10 V2 Z" fill="#FFD700" opacity="0.95" />
                            <circle cx="12" cy="7.5" r="2" fill="#FFF" class="animate-pulse" />
                        </svg>
                        <span class="text-xs uppercase tracking-[0.5em] text-gold-100 font-bold group-hover:text-white transition-colors">Adoratio</span>
                    </a>
                </div>

                <!-- DAILY MANNA WIDGET -->
                <div class="relative group w-64 text-center mt-4 mb-4">
                    <div class="absolute inset-0 bg-gold-900/10 blur-xl rounded-full opacity-0 group-hover:opacity-50 transition-opacity"></div>
                    <p class="text-gold-200/80 font-serif italic text-sm leading-relaxed drop-shadow-md">
                        "{dailyManna.text}"
                    </p>
                    <p class="text-[9px] text-gold-500 uppercase tracking-widest mt-2 opacity-60">
                        — {dailyManna.source}
                    </p>
                </div>

                <!-- Liturgical Tools (Row) -->
                <div class="flex gap-7 md:gap-8 justify-center items-center opacity-80">
                     <!-- Calendar -->
                     <a href="/calendar" class="flex flex-col items-center gap-2 group text-gold-500/70 hover:text-gold-400" aria-label="Kirkekalenderen">
                         <i class="fa-solid fa-calendar-day text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>

                     <!-- Prayers -->
                     <a href="/prayers" class="flex flex-col items-center gap-2 group text-gold-500/70 hover:text-gold-400" aria-label="Bønner">
                         <i class="fa-solid fa-hands-praying text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>

                     <!-- Mass times / find a church -->
                     <a href="/locations" class="flex flex-col items-center gap-2 group text-gold-500/70 hover:text-gold-400" aria-label="Find en kirke og messetider">
                         <i class="fa-solid fa-location-dot text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>

                     <!-- Community -->
                     <a href="/community" class="flex flex-col items-center gap-2 group text-white/60 hover:text-white" aria-label="Fællesskab og forbøn">
                         <i class="fa-solid fa-users text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>

                     <!-- Candles -->
                     <a href="/candles" class="flex flex-col items-center gap-2 group text-orange-500/70 hover:text-orange-400" aria-label="Tænd et lys">
                         <i class="fa-solid fa-fire text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>

                     <!-- Rosary -->
                     <a href="/rosary" class="flex flex-col items-center gap-2 group text-gold-500/70 hover:text-gold-400" aria-label="Rosenkransen">
                         <i class="fa-solid fa-dharmachakra text-xl group-hover:-translate-y-1 transition-transform" aria-hidden="true"></i>
                     </a>
                </div>

                <!-- NEWCOMER ENTRY -->
                <a href="/seek" class="group mt-2 inline-flex items-center gap-3 rounded-full border border-gold-500/30 bg-black/20 px-5 py-2 text-gold-200/80 hover:text-white hover:border-gold-400/60 transition-colors backdrop-blur-sm">
                    <span class="text-[10px] uppercase tracking-[0.25em] sans">Ny her? Find vejen hjem</span>
                    <i class="fa-solid fa-arrow-right text-xs text-gold-500 group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
                </a>

            </div>

            <!-- COLUMN 3: THE CRYPT (Penitence & Depths) -->
            <div class="flex-1 flex flex-col gap-6 items-center md:items-start text-left order-3 opacity-90 hover:opacity-100 transition-opacity">
                 <div class="text-[10px] uppercase tracking-[0.4em] text-gold-500/50 mb-2 border-b border-gold-900 pb-2 w-24 text-center md:text-left">Crypt</div>

                 <a href="/confession" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block"><i class="fa-solid fa-user-secret mr-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i> Confessio</span>
                 </a>
                 <a href="/desert" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block"><i class="fa-solid fa-wind mr-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i> Eremita</span>
                 </a>
                 <a href="/via-dolorosa" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block"><i class="fa-solid fa-road mr-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i> Via Dolorosa</span>
                 </a>
                 <a href="/catacombs" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block"><i class="fa-solid fa-skull mr-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i> Memoria</span>
                 </a>
                 <a href="/testimony" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block"><i class="fa-solid fa-quote-right mr-2 text-gold-500/40 group-hover:text-gold-400" aria-hidden="true"></i> Vidnesbyrd</span>
                 </a>
                 <div class="h-px w-12 bg-white/10 my-2"></div>
                 <a href="/seek" class="nav-link group">
                    <span class="group-hover:translate-x-[5px] transition-transform block text-gold-200"><i class="fa-solid fa-compass mr-2 text-gold-500 group-hover:text-gold-400" aria-hidden="true"></i> Vejen Hjem</span>
                 </a>
            </div>

        </div>

        <!-- THE GALLERY (Bottom Row - Sensory Experiences) -->
        <div class="absolute bottom-10 w-full flex justify-center z-20 px-4">
            <div class="backdrop-blur-sm bg-black/20 border border-white/5 rounded-full px-6 md:px-8 py-3 flex gap-6 md:gap-10 items-center shadow-2xl flex-wrap justify-center">

                <a href="/campanile" class="gallery-item group tooltip-container" aria-label="Klokketårnet">
                    <i class="fa-solid fa-bell" aria-hidden="true"></i>
                    <span class="tooltip">Klokketårnet</span>
                </a>

                <a href="/caelum" class="gallery-item group tooltip-container" aria-label="Observatoriet">
                    <i class="fa-solid fa-star" aria-hidden="true"></i>
                     <span class="tooltip">Observatoriet</span>
                </a>

                <a href="/rose-window" class="gallery-item group tooltip-container" aria-label="Rosevinduet">
                    <i class="fa-solid fa-fan" aria-hidden="true"></i>
                     <span class="tooltip">Rosevinduet</span>
                </a>

                <a href="/organ-loft" class="gallery-item group tooltip-container" aria-label="Orglet">
                    <i class="fa-solid fa-music" aria-hidden="true"></i>
                     <span class="tooltip">Orglet</span>
                </a>

                 <a href="/illuminator" class="gallery-item group tooltip-container" aria-label="Illuminator">
                    <i class="fa-solid fa-paint-brush" aria-hidden="true"></i>
                     <span class="tooltip">Illuminator</span>
                </a>

                <a href="/thurible" class="gallery-item group tooltip-container" aria-label="Røgelseskar">
                    <i class="fa-solid fa-wind" aria-hidden="true"></i>
                     <span class="tooltip">Røgelse</span>
                </a>

                <a href="/hortus-conclusus" class="gallery-item group tooltip-container" aria-label="Den lukkede have">
                    <i class="fa-solid fa-seedling" aria-hidden="true"></i>
                     <span class="tooltip">Haven</span>
                </a>

                <a href="/lacus" class="gallery-item group tooltip-container" aria-label="Lacus — søen">
                    <i class="fa-solid fa-water" aria-hidden="true"></i>
                     <span class="tooltip">Lacus</span>
                </a>

                <a href="/mentor" class="gallery-item group tooltip-container" aria-label="Åndelig mentor">
                    <i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
                     <span class="tooltip">Mentor</span>
                </a>

                <a href="/treasury" class="gallery-item group tooltip-container" aria-label="Skatkammeret">
                    <i class="fa-solid fa-gem" aria-hidden="true"></i>
                     <span class="tooltip">Skatkammeret</span>
                </a>

                <a href="/saints" class="gallery-item group tooltip-container" aria-label="Sanctorale — helgenerne">
                    <i class="fa-solid fa-crown" aria-hidden="true"></i>
                     <span class="tooltip">Sanctorale</span>
                </a>

                <a href="/login" class="gallery-item group tooltip-container" aria-label="Pilgrimspas — log ind">
                    <i class="fa-solid fa-passport" aria-hidden="true"></i>
                     <span class="tooltip">Pilgrimspas</span>
                </a>
            </div>
        </div>

    </div>

    <!-- AUDIO -->
    <audio id="shrine-audio" loop preload="auto">
        <source src="/assets/audio/chant.mp3" type="audio/mpeg">
    </audio>

</Layout>

<script>
    // Audio Elements
    const audio = document.getElementById('shrine-audio') as HTMLAudioElement;
    const muteBtn = document.getElementById('mute-btn');
    const volIcon = muteBtn?.querySelector('.fa-volume-high');
    const muteIcon = muteBtn?.querySelector('.fa-volume-xmark');
    const playIcon = muteBtn?.querySelector('.fa-play');

    // Start Logic on Load
    window.addEventListener('load', async () => {
        // Try Autoplay
        audio.volume = 1.0;
        try {
            await audio.play();
            // Success
            volIcon?.classList.remove('hidden');
            muteIcon?.classList.add('hidden');
            playIcon?.classList.add('hidden');
        } catch (e) {
            console.log("Autoplay blocked. Showing Play button.", e);
            // Fallback
            volIcon?.classList.add('hidden');
            muteIcon?.classList.add('hidden');
            playIcon?.classList.remove('hidden');
            muteBtn?.classList.add('animate-pulse');
        }
    });

    // Mute/Play Control
    muteBtn?.addEventListener('click', async () => {
        if (audio.paused) {
            // Manual Start
            try {
                await audio.play();
                volIcon?.classList.remove('hidden');
                muteIcon?.classList.add('hidden');
                playIcon?.classList.add('hidden');
                muteBtn.classList.remove('animate-pulse');
            } catch(e) { console.error(e); }
        } else {
            // Toggle Mute
            audio.muted = !audio.muted;
            if(audio.muted) {
                volIcon?.classList.add('hidden');
                muteIcon?.classList.remove('hidden');
            } else {
                volIcon?.classList.remove('hidden');
                muteIcon?.classList.add('hidden');
            }
        }
    });
</script>

<style>
    .nav-link {
        color: rgba(255, 255, 255, 0.55);
        font-family: 'Cinzel', serif;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        transition: all 0.3s ease;
    }
    .nav-link:hover {
        color: #fff;
        text-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
    }

    .gallery-item {
        color: rgba(255, 215, 0, 0.45);
        font-size: 1.2rem;
        transition: all 0.3s ease;
        position: relative;
    }
    .gallery-item:hover {
        color: rgba(255, 215, 0, 1);
        transform: scale(1.2);
        text-shadow: 0 0 15px rgba(255, 215, 0, 0.6);
    }

    .tooltip {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        background: rgba(0,0,0,0.8);
        color: #aaa;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .gallery-item:hover .tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    /* Animation Keyframes */
    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }
    .animate-pulse-slow {
        animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes smokeRise {
        0% { transform: translateY(0) scale(1); opacity: 0.3; }
        50% { transform: translateY(-30px) scale(1.1); opacity: 0.2; }
        100% { transform: translateY(-60px) scale(1.2); opacity: 0; }
    }
    .animate-smoke-rise {
        animation: smokeRise 15s infinite ease-in-out;
    }
    .animate-smoke-rise-slow {
        animation: smokeRise 25s infinite ease-in-out reverse;
    }
</style>
