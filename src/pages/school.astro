
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bønneskolen | Oratorium</title>
    <meta name="robots" content="index, follow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #050508; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
        .serif-italic { font-family: 'Playfair Display', serif; font-style: italic; }
        
        /* Flip Card */
        .prayer-card {
            perspective: 1000px;
        }
        .prayer-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.8s;
            transform-style: preserve-3d;
        }
        .prayer-card.flipped .prayer-card-inner {
            transform: rotateY(180deg);
        }
        .prayer-front, .prayer-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 0.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .prayer-front {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .prayer-back {
            background: #0f0a05;
            border: 1px solid rgba(212, 175, 55, 0.3);
            transform: rotateY(180deg);
        }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/seek" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <!-- Header -->
    <header class="text-center mb-16 px-4">
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-6 font-serif drop-shadow-lg">Bønneskolen</h1>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans max-w-lg mx-auto leading-loose">
            "Herre, lær os at bede." — Lukas 11,1
        </p>
    </header>

    <!-- Content Container -->
    <main class="max-w-4xl mx-auto px-6 pb-32 space-y-24">
        
        <!-- SECTION 1: THE FOUNDATION -->
        <section class="text-center">
            <div class="w-16 h-16 mx-auto bg-gold-900/10 rounded-full flex items-center justify-center text-gold-500 text-2xl mb-6 border border-gold-500/20">
                <i class="fa-solid fa-hands-praying"></i>
            </div>
            <h2 class="text-2xl text-gold-200 mb-4 font-serif">1. Grundvolden</h2>
            <p class="text-gray-400 sans text-sm leading-relaxed max-w-2xl mx-auto mb-12">
                Bøn er ikke magi. Det er en samtale. Det starter med stilhed og tegnet på, hvem vi tilhører.
            </p>
            
            <div class="bg-white/5 border border-white/10 p-8 rounded text-left flex flex-col md:flex-row gap-8 items-center">
                <div class="flex-1">
                    <h3 class="text-lg text-gold-100 mb-2">Korsets Tegn</h3>
                    <p class="text-xs text-gray-500 uppercase tracking-widest mb-4">In Nomine Patris</p>
                    <p class="text-gray-300 sans text-sm leading-relaxed mb-4">
                        Vi starter og slutter altid med korsets tegn. Det minder os om vores dåb og Guds Treenighed.
                    </p>
                    <div class="bg-black/30 p-4 rounded border border-white/5 font-serif text-gold-500/80 italic text-center">
                        "I Faderens og Sønnens og Helligåndens navn. Amen."
                    </div>
                </div>
                <!-- Visual Steps -->
                <div class="flex gap-4 opacity-50">
                    <div class="text-center">
                        <div class="w-8 h-8 rounded-full border border-gray-500 flex items-center justify-center text-xs mb-1">1</div>
                        <span class="text-[10px] uppercase">Pande</span>
                    </div>
                    <div class="text-center">
                        <div class="w-8 h-8 rounded-full border border-gray-500 flex items-center justify-center text-xs mb-1">2</div>
                        <span class="text-[10px] uppercase">Bryst</span>
                    </div>
                    <div class="text-center">
                        <div class="w-8 h-8 rounded-full border border-gray-500 flex items-center justify-center text-xs mb-1">3</div>
                        <span class="text-[10px] uppercase">Venstre</span>
                    </div>
                    <div class="text-center">
                        <div class="w-8 h-8 rounded-full border border-gray-500 flex items-center justify-center text-xs mb-1">4</div>
                        <span class="text-[10px] uppercase">Højre</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: THE BASICS (FLIP CARDS) -->
        <section>
            <h2 class="text-2xl text-gold-200 mb-12 font-serif text-center">2. De Første Bønner</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                
                <!-- PATER NOSTER -->
                <div class="prayer-card h-96 cursor-pointer group" onclick="this.classList.toggle('flipped')">
                    <div class="prayer-card-inner">
                        <!-- Front -->
                        <div class="prayer-front">
                            <i class="fa-solid fa-crown text-gold-500 text-3xl mb-4"></i>
                            <h3 class="text-xl text-white font-serif mb-2">Fadervor</h3>
                            <p class="text-xs text-gray-500 uppercase tracking-widest mb-6">Herrens Bøn</p>
                            <p class="text-gray-400 sans text-sm">Den bøn Jesus selv lærte os. Den mest perfekte af alle bønner.</p>
                            <span class="mt-8 text-[10px] uppercase tracking-widest text-gold-500 group-hover:underline">Klik for at læse bønnen</span>
                        </div>
                        <!-- Back -->
                        <div class="prayer-back">
                            <h3 class="text-gold-500 text-xs uppercase tracking-widest mb-4">Matthæus 6,9-13</h3>
                            <p class="serif-italic text-gray-200 leading-loose text-sm p-4">
                                "Fader vor, du som er i himlene!
                                Helliget vorde dit navn,
                                komme dit rige,
                                ske din vilje
                                som i himlen således også på jorden..."
                            </p>
                        </div>
                    </div>
                </div>

                <!-- AVE MARIA -->
                <div class="prayer-card h-96 cursor-pointer group" onclick="this.classList.toggle('flipped')">
                    <div class="prayer-card-inner">
                        <!-- Front -->
                        <div class="prayer-front">
                            <i class="fa-solid fa-rose text-red-400 text-3xl mb-4"></i>
                            <h3 class="text-xl text-white font-serif mb-2">Hil Dig, Maria</h3>
                            <p class="text-xs text-gray-500 uppercase tracking-widest mb-6">Ave Maria</p>
                            <p class="text-gray-400 sans text-sm">Vi beder ikke <em>til</em> Maria, men <em>med</em> hende. Vi beder hende bære vores bønner til Jesus.</p>
                            <span class="mt-8 text-[10px] uppercase tracking-widest text-gold-500 group-hover:underline">Klik for at læse bønnen</span>
                        </div>
                        <!-- Back -->
                        <div class="prayer-back">
                            <h3 class="text-gold-500 text-xs uppercase tracking-widest mb-4">Lukas 1,28</h3>
                            <p class="serif-italic text-gray-200 leading-loose text-sm p-4">
                                "Hil dig, Maria, fuld af nåde!
                                Herren er med dig.
                                Velsignet er du iblandt kvinder,
                                og velsignet er dit livs frugt, Jesus."
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- SECTION 3: ADVANCED TOOLS -->
        <section class="text-center">
            <h2 class="text-2xl text-gold-200 mb-12 font-serif">3. Dit Værktøjskasse</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Rosary Link -->
                <a href="/rosary" class="block bg-white/5 border border-white/10 p-6 rounded hover:bg-white/10 hover:border-gold-500/30 transition-all group">
                    <i class="fa-solid fa-bullseye text-red-500 text-2xl mb-4 group-hover:scale-110 transition-transform block"></i>
                    <h3 class="text-gold-100 font-serif mb-2">Rosenkransen</h3>
                    <p class="text-xs text-gray-400 sans">Meditativ bøn med perlekæde. Perfekt til ro.</p>
                </a>
                
                <!-- Lectio Link -->
                <a href="/lectio" class="block bg-white/5 border border-white/10 p-6 rounded hover:bg-white/10 hover:border-gold-500/30 transition-all group">
                    <i class="fa-solid fa-book-open text-blue-400 text-2xl mb-4 group-hover:scale-110 transition-transform block"></i>
                    <h3 class="text-gold-100 font-serif mb-2">Lectio Divina</h3>
                    <p class="text-xs text-gray-400 sans">Læsning af Dagens Tekst med hjertet.</p>
                </a>

                <!-- Prayer Wall Link -->
                <a href="/prayers" class="block bg-white/5 border border-white/10 p-6 rounded hover:bg-white/10 hover:border-gold-500/30 transition-all group">
                    <i class="fa-solid fa-fire-flame-curved text-orange-400 text-2xl mb-4 group-hover:scale-110 transition-transform block"></i>
                    <h3 class="text-gold-100 font-serif mb-2">Bønnevæggen</h3>
                    <p class="text-xs text-gray-400 sans">Bed for andre, og lad andre bede for dig.</p>
                </a>
            </div>
        </section>

    </main>

</body>
</html>
