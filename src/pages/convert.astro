
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bliv Katolik | Vejen Ind</title>
    <meta name="robots" content="index, follow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #080808; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
        
        .step-line {
            position: absolute;
            left: 2rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: linear-gradient(to bottom, transparent, #D4AF37, transparent);
            z-index: 0;
        }
        @media (min-width: 768px) {
            .step-line { left: 50%; transform: translateX(-50%); }
        }

        .step-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 40px rgba(212,175,55,0.1);
            border-color: rgba(212,175,55,0.4);
        }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/seek" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>
    
    <!-- Header -->
    <header class="text-center mb-24 px-4 relative z-10">
        <div class="inline-block p-6 border rounded-full border-gold-500/20 mb-8 animate-pulse">
            <i class="fa-solid fa-church text-gold-500 text-4xl"></i>
        </div>
        <h1 class="text-4xl md:text-6xl text-gold-100 mb-6 font-serif drop-shadow-lg">Vejen ind i Kirken</h1>
        <p class="text-xs text-gold-500 uppercase tracking-[0.3em] sans max-w-lg mx-auto leading-loose">
            Fra søgende til troende. En rejse i tre trin.
        </p>
    </header>

    <!-- Content -->
    <main class="relative max-w-5xl mx-auto px-6 pb-48">
        <div class="step-line"></div>

        <!-- Step 1: Contact -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-8 mb-24 items-center group">
            <div class="order-2 md:order-1 text-right pr-12 hidden md:block">
                <span class="text-6xl text-white/5 font-bold group-hover:text-gold-500/20 transition-colors">I</span>
            </div>
            
            <div class="absolute left-8 md:left-1/2 -translate-x-1/2 w-8 h-8 bg-[#080808] border border-gold-500 rounded-full z-20 flex items-center justify-center">
                <div class="w-3 h-3 bg-gold-500 rounded-full"></div>
            </div>

            <div class="order-3 md:order-2 pl-12 md:pl-16">
                 <div class="step-card bg-[#111] border border-white/10 p-8 rounded-lg transition-all duration-300">
                    <h2 class="text-2xl text-gold-200 font-serif mb-4 flex items-center gap-3">
                        <i class="fa-regular fa-comments text-gold-500 text-xl"></i> Kontakt
                    </h2>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Det første skridt er det sværeste: At sige "Hej".<br>
                        Find din nærmeste katolske kirke og kontakt præsten. Bed om en samtale om at blive katolik.
                    </p>
                    <a href="/locations" class="inline-flex items-center text-xs uppercase tracking-widest text-gold-500 hover:text-white transition-colors border-b border-gold-500/30 pb-1">
                        Find en kirke nær dig <i class="fa-solid fa-arrow-right ml-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Step 2: Catechumenate -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-8 mb-24 items-center group">
             <div class="order-3 md:order-1 pr-0 md:pr-16 pl-12 md:pl-0">
                <div class="step-card bg-[#111] border border-white/10 p-8 rounded-lg transition-all duration-300 text-left md:text-right">
                    <h2 class="text-2xl text-gold-200 font-serif mb-4 flex items-center gap-3 md:flex-row-reverse">
                        <i class="fa-solid fa-book-open-reader text-gold-500 text-xl"></i> Undervisning
                    </h2>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-4">
                        Dette kaldes "Katekumenatet". Det varer typisk fra efteråret til påske (ca. 6-9 måneder).
                    </p>
                    <ul class="text-gray-500 sans text-xs space-y-2 list-inside md:list-none">
                        <li><i class="fa-solid fa-check text-green-900 mr-2 md:hidden"></i>Du lærer troen at kende.</li>
                        <li><i class="fa-solid fa-check text-green-900 mr-2 md:hidden"></i>Du deltager i Messen (uden kommunion).</li>
                        <li><i class="fa-solid fa-check text-green-900 mr-2 md:hidden"></i>Du afgør, om Kirken er dit hjem.</li>
                    </ul>
                </div>
            </div>
            
            <div class="absolute left-8 md:left-1/2 -translate-x-1/2 w-8 h-8 bg-[#080808] border border-gold-500 rounded-full z-20 flex items-center justify-center">
                <div class="w-3 h-3 bg-gold-500 rounded-full"></div>
            </div>

            <div class="order-2 md:order-2 pl-12 hidden md:block">
                 <span class="text-6xl text-white/5 font-bold group-hover:text-gold-500/20 transition-colors">II</span>
            </div>
        </div>

        <!-- Step 3: Sacraments -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-8 items-center group">
            <div class="order-2 md:order-1 text-right pr-12 hidden md:block">
                <span class="text-6xl text-white/5 font-bold group-hover:text-gold-500/20 transition-colors">III</span>
            </div>
            
            <div class="absolute left-8 md:left-1/2 -translate-x-1/2 w-8 h-8 bg-[#080808] border border-gold-500 rounded-full z-20 flex items-center justify-center shadow-[0_0_20px_gold]">
                <div class="w-3 h-3 bg-gold-500 rounded-full"></div>
            </div>

            <div class="order-3 md:order-2 pl-12 md:pl-16">
                 <div class="step-card bg-[#111] border border-white/10 p-8 rounded-lg transition-all duration-300">
                    <h2 class="text-2xl text-gold-200 font-serif mb-4 flex items-center gap-3">
                        <i class="fa-solid fa-water text-gold-500 text-xl"></i> Optagelse
                    </h2>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Det store øjeblik sker oftest Påskenat (Vigilien).
                    </p>
                    <div class="space-y-4 border-l border-gold-500/20 pl-4">
                        <div>
                            <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-1">Dåb (hvis ikke døbt)</h3>
                            <p class="text-gray-500 text-xs">Du genfødes af vand og ånd.</p>
                        </div>
                        <div>
                            <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-1">Konversion (hvis allerede døbt)</h3>
                            <p class="text-gray-500 text-xs">Du optages fuldt i Kirken.</p>
                        </div>
                        <div>
                            <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-1">Firmelse & Eukaristi</h3>
                            <p class="text-gray-500 text-xs">Du modtager Helligånden og Kristi Legeme for første gang.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
    
    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-6 pb-32 text-center">
        <h3 class="text-xl text-gold-500 font-serif mb-8">Ofte Stillede Spørgsmål</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
            <div class="bg-white/5 p-6 rounded">
                <h4 class="text-white text-xs uppercase tracking-widest mb-2 font-bold">Koster det penge?</h4>
                <p class="text-gray-400 text-sm sans">Nej. Troen er gratis. Senere betaler man kirkeskat som medlem, men undervisningen er gratis.</p>
            </div>
             <div class="bg-white/5 p-6 rounded">
                <h4 class="text-white text-xs uppercase tracking-widest mb-2 font-bold">Kan jeg fortryde?</h4>
                <p class="text-gray-400 text-sm sans">Ja. Du er fri til at stoppe katekumenatet når som helst. Der er ingen tvang.</p>
            </div>
        </div>
    </section>

</body>
</html>
