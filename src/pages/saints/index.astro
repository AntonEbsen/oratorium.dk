---
import Layout from '@layouts/Layout.astro';
import { saints } from '../../data/saints';

// Simple "Saint of the Day" logic based on day of year hash
const today = new Date();
const dayOfYear = Math.floor((today.getTime() - new Date(today.getFullYear(), 0, 0).getTime()) / 1000 / 60 / 60 / 24);
const dailySaintIndex = dayOfYear % saints.length;
const dailySaint = saints[dailySaintIndex];
---

<Layout
    title="Helgengalleriet | Oratorium"
    description="Helgengalleriet — mød Kirkens helgener, dine åndelige brødre og søstre. Find din skytshelgen og lad dig inspirere af deres liv."
    extraFonts={["Playfair+Display:ital@0;1"]}
    bodyClass="selection:bg-gold-500/30 min-h-screen flex flex-col pt-32"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #050508; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
        .serif-italic { font-family: 'Playfair Display', serif; font-style: italic; }
        
        .halo-glow {
            box-shadow: 0 0 50px rgba(255, 215, 0, 0.2);
        }
</style>
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/seek" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>
    
    <!-- Quiz CTA (Corner) -->
    <a href="/saints/quiz" class="fixed bottom-8 right-8 z-50 bg-gold-600 text-black px-6 py-3 rounded-full flex items-center gap-3 shadow-[0_0_20px_rgba(255,215,0,0.4)] hover:scale-105 transition-transform font-bold uppercase tracking-widest text-xs animate-bounce-slow">
        <i class="fa-solid fa-question-circle text-lg"></i>
        Find din Helgen
    </a>

    <!-- Header -->
    <header class="text-center mb-16 px-4">
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-6 font-serif drop-shadow-lg">Helgeners Samfund</h1>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans max-w-lg mx-auto leading-loose">
            "Vi er omgivet af så stor en sky af vidner." — Hebræerbrevet 12,1
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 pb-32">
        
        <!-- DAILY SAINT HERO -->
        <section class="mb-24">
            <div class="bg-[#0a0a0f] border border-gold-500/30 rounded-xl overflow-hidden relative halo-glow max-w-4xl mx-auto flex flex-col md:flex-row">
                <!-- Image / Icon Placeholder -->
                <div class="w-full md:w-1/3 bg-gold-900/10 flex items-center justify-center p-12 border-b md:border-b-0 md:border-r border-gold-500/20">
                    <i class="fa-solid fa-user-astronaut text-8xl text-gold-500/50"></i> <!-- Generic Icon -->
                </div>
                
                <!-- Content -->
                <div class="p-8 md:p-12 flex-1 flex flex-col justify-center">
                    <span class="text-[10px] text-gold-500 uppercase tracking-widest mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-star text-gold-500 animate-pulse"></i> Dagens Helgen
                    </span>
                    <h2 class="text-3xl md:text-4xl text-white font-serif mb-2">{dailySaint.name}</h2>
                    <p class="text-gold-500/60 font-serif italic text-lg mb-6">{dailySaint.title}</p>
                    
                    <p class="text-gray-300 sans text-sm leading-relaxed mb-6">
                        {dailySaint.description}
                    </p>
                    
                    <blockquote class="border-l-2 border-gold-500/50 pl-4 py-1 mb-8">
                        <p class="serif-italic text-gray-400 text-lg">"{dailySaint.quote}"</p>
                    </blockquote>

                    <div class="flex items-center gap-4 text-xs text-gray-500 uppercase tracking-widest">
                        <span><i class="fa-regular fa-calendar mr-2"></i> Festdag: {dailySaint.feastDate}</span>
                        <span class="px-2 py-1 bg-white/5 rounded border border-white/10">{dailySaint.category}</span>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- SAINT GRID -->
        <section>
             <h3 class="text-xl text-gold-500 mb-8 font-serif border-b border-white/10 pb-4">Alle Helgener</h3>
             
             <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {saints.map(saint => (
                    <div class="bg-white/5 border border-white/10 p-6 rounded hover:bg-white/10 hover:border-gold-500/30 transition-all group">
                         <div class="flex items-start justify-between mb-4">
                            <span class="text-[10px] bg-black/50 px-2 py-1 rounded text-gray-500 border border-white/5 group-hover:border-gold-500/20 transition-colors">
                                {saint.category}
                            </span>
                            <i class="fa-solid fa-cross text-white/10 group-hover:text-gold-500 transition-colors"></i>
                         </div>
                         
                         <h3 class="text-xl text-gold-100 font-serif mb-1 group-hover:text-white transition-colors">{saint.name}</h3>
                         <p class="text-xs text-gold-500/50 mb-4">{saint.title}</p>
                         
                         <p class="text-gray-400 sans text-xs leading-relaxed line-clamp-3">
                             {saint.description}
                         </p>
                    </div>
                ))}
             </div>
        </section>

    </main>

    <style>
        .animate-bounce-slow {
            animation: bounce 3s infinite;
        }
    </style>
</Layout>
