---
import Layout from '@layouts/Layout.astro';
import { scenarios } from '../data/apologetics';
---

<Layout
    fullscreen
    title="Scutum Fidei | Troens Skjold"
    noindex
    bodyClass="text-white h-screen w-screen flex flex-col overflow-hidden relative selection:bg-gold-500/30"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #050505; }
        .sans { font-family: 'Inter', sans-serif; }
        
        .shield-glow {
            filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.5));
        }
        
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(255, 215, 0, 0.1);
            border-color: rgba(255, 215, 0, 0.4);
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        .shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }

        @keyframes pulse-gold {
            0% { box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7); }
            70% { box-shadow: 0 0 0 20px rgba(255, 215, 0, 0); }
            100% { box-shadow: 0 0 0 0 rgba(255, 215, 0, 0); }
        }
        .pulse-gold { animation: pulse-gold 1s infinite; }

        /* Accordion Styles */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
        .accordion-content.open {
            max-height: 500px; /* arbitrary large value */
        }
</style>
    <!-- Back -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Retur</span>
        </a>
    </nav>

    <!-- Header & Toggle -->
    <div class="fixed top-8 right-8 z-50 flex flex-col items-end gap-4">
        <div class="text-right">
            <h1 class="text-2xl font-bold text-gold-500 tracking-wider">Scutum Fidei</h1>
            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-500">Apologetisk Træning</p>
        </div>

        <!-- Mode Switcher -->
        <div class="bg-white/5 border border-white/10 rounded-full p-1 flex gap-1 backdrop-blur-sm">
            <button onclick="switchMode('training')" id="btn-training" class="px-4 py-1.5 rounded-full text-[10px] uppercase tracking-widest bg-gold-600 text-black font-bold transition-all">
                Træning
            </button>
            <button onclick="switchMode('archive')" id="btn-archive" class="px-4 py-1.5 rounded-full text-[10px] uppercase tracking-widest text-gray-400 hover:text-white transition-all">
                Arkiv
            </button>
        </div>
    </div>

    <!-- MAIN ARENA (Training Mode) -->
    <div id="mode-training" class="relative z-10 max-w-4xl mx-auto w-full h-full flex flex-col items-center justify-center p-6">
        
        <!-- ENEMY (The Objection) -->
        <div id="enemy-section" class="w-full text-center mb-12 animate-fade-in-up">
            <div class="inline-block px-4 py-1 border border-red-500/30 rounded-full text-red-400 text-[10px] uppercase tracking-widest mb-4">
                <i class="fa-solid fa-triangle-exclamation mr-2"></i> Indsigelse
            </div>
            <h2 id="objection-text" class="text-xl md:text-3xl font-bold text-white mb-2 leading-relaxed max-w-2xl mx-auto">
                "Here is where the objection text goes..."
            </h2>
            <p id="objection-source" class="text-sm text-gray-500 italic sans"></p>
        </div>

        <!-- THE SHIELD (Visual Feedback) -->
        <div class="mb-12 relative">
            <div id="shield-icon" class="text-8xl text-gray-800 transition-all duration-500">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <!-- Hit Effect -->
            <div id="hit-effect" class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-0 transition-opacity"></div>
        </div>

        <!-- PLAYER (The Response) -->
        <div id="response-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full">
            <!-- Cards injected by JS -->
        </div>

        <!-- VICTORY / EXPLANATION OVERLAY -->
        <div id="explanation-box" class="hidden absolute inset-0 z-20 bg-black/95 flex flex-col items-center justify-center p-8 text-center backdrop-blur-md">
            <div class="text-6xl text-gold-500 mb-6 drop-shadow-[0_0_20px_rgba(255,215,0,0.5)]">
                <i class="fa-solid fa-check-circle"></i>
            </div>
            <h3 class="text-2xl text-white font-bold mb-4 uppercase tracking-widest">Deflected!</h3>
            <p id="explanation-text" class="text-lg text-gray-300 leading-relaxed max-w-xl serif mb-8"></p>
            <button onclick="nextRound()" class="px-8 py-3 bg-gold-600/20 border border-gold-500 text-gold-500 hover:bg-gold-500 hover:text-black transition-all uppercase tracking-widest text-sm rounded">
                Næste Udfordring
            </button>
        </div>

    </div>

    <!-- ARCHIVE MODE (Library) -->
    <div id="mode-archive" class="hidden relative z-10 max-w-4xl mx-auto w-full h-full p-6 pt-32 overflow-y-auto pb-20 scroll-smooth">
        <h2 class="text-xl text-gold-500 mb-8 border-b border-white/10 pb-4 font-serif">Apologetisk Arkiv</h2>
        
        <div class="space-y-4">
            {scenarios.map((s, i) => (
                <div class="bg-white/5 border border-white/10 rounded overflow-hidden">
                    <button class="w-full text-left p-6 flex items-center justify-between hover:bg-white/5 transition-colors group" onclick={`toggleAccordion('${s.id}')`}>
                        <div>
                            <span class="text-[10px] text-gray-500 uppercase tracking-widest mb-1 block">{s.category} · {s.objectionSource}</span>
                            <h3 class="text-gray-200 group-hover:text-white font-serif leading-tight pr-4">"{s.objection}"</h3>
                        </div>
                        <i id={`icon-${s.id}`} class="fa-solid fa-chevron-down text-gold-500/50 transition-transform duration-300"></i>
                    </button>
                    
                    <div id={`content-${s.id}`} class="accordion-content bg-black/50 border-t border-white/5">
                        <div class="p-6">
                            <div class="flex items-start gap-4 mb-4">
                                <i class="fa-solid fa-shield-halved text-gold-500 mt-1"></i>
                                <div>
                                    <h4 class="text-gold-500 text-xs uppercase tracking-widest mb-2 font-bold">Det Katolske Svar</h4>
                                    <p class="text-gray-300 sans text-sm leading-relaxed">
                                        {s.explanation}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <script define:vars={{ scenarios }}>
        // --- MODE SWITCHING ---
        const modeTraining = document.getElementById('mode-training');
        const modeArchive = document.getElementById('mode-archive');
        const btnTraining = document.getElementById('btn-training');
        const btnArchive = document.getElementById('btn-archive');

        window.switchMode = (mode) => {
            if(mode === 'training') {
                modeTraining.classList.remove('hidden');
                modeArchive.classList.add('hidden');
                
                btnTraining.classList.add('bg-gold-600', 'text-black');
                btnTraining.classList.remove('text-gray-400', 'hover:text-white');
                
                btnArchive.classList.remove('bg-gold-600', 'text-black');
                btnArchive.classList.add('text-gray-400', 'hover:text-white');
            } else {
                modeTraining.classList.add('hidden');
                modeArchive.classList.remove('hidden');
                
                btnArchive.classList.add('bg-gold-600', 'text-black');
                btnArchive.classList.remove('text-gray-400', 'hover:text-white');
                
                btnTraining.classList.remove('bg-gold-600', 'text-black');
                btnTraining.classList.add('text-gray-400', 'hover:text-white');
            }
        };


        // --- TRAINING LOGIC ---
        let currentScenarioIndex = 0;
        let currentScenario = null;

        const objectionText = document.getElementById('objection-text');
        const objectionSource = document.getElementById('objection-source');
        const responseGrid = document.getElementById('response-grid');
        const shieldIcon = document.getElementById('shield-icon');
        const explanationBox = document.getElementById('explanation-box');
        const explanationText = document.getElementById('explanation-text');

        function loadScenario(index) {
            if (index >= scenarios.length) {
                // Game Over / Win Loop
                currentScenarioIndex = 0;
            }
            
            currentScenario = scenarios[currentScenarioIndex];
            
            // UI text
            objectionText.innerText = `"${currentScenario.objection}"`;
            objectionSource.innerText = "— " + (currentScenario.objectionSource || "Ukendt kilde");
            
            // Logic: Shuffle responses
            const responses = [...currentScenario.responses].sort(() => Math.random() - 0.5);
            
            // Build Grid
            responseGrid.innerHTML = '';
            responses.forEach(resp => {
                const btn = document.createElement('button');
                btn.className = "p-6 bg-[#1a1a20] border border-gray-800 rounded text-left group hover:border-gold-500/50 transition-all card-hover relative overflow-hidden h-full";
                btn.onclick = () => checkAnswer(resp.id);
                
                btn.innerHTML = `
                    <p class="text-xs text-gray-500 mb-2 uppercase tracking-widest group-hover:text-gold-500/50 font-mono">Responsum</p>
                    <p class="text-sm text-gray-300 sans leading-relaxed group-hover:text-white">${resp.text}</p>
                `;
                responseGrid.appendChild(btn);
            });
            
            // Reset visuals
            shieldIcon.className = "text-8xl text-gray-700 transition-all duration-500";
            explanationBox.classList.add('hidden');
        }

        function checkAnswer(responseId) {
            if(!currentScenario) return;

            if (responseId === currentScenario.correctResponseId) {
                // WIN
                shieldIcon.className = "text-8xl text-gold-500 shield-glow scale-110 duration-300";
                setTimeout(() => {
                    explanationText.innerText = currentScenario.explanation;
                    explanationBox.classList.remove('hidden');
                }, 600);
            } else {
                // LOSE
                shieldIcon.className = "text-8xl text-red-800 shake duration-100";
            }
        }

        // Global scoped for button onclick
        window.nextRound = function() {
            currentScenarioIndex++;
            loadScenario(currentScenarioIndex);
        };

        window.checkAnswer = checkAnswer;


        // --- ARCHIVE LOGIC ---
        window.toggleAccordion = (id) => {
            const content = document.getElementById(`content-${id}`);
            const icon = document.getElementById(`icon-${id}`);
            
            if (content.classList.contains('open')) {
                content.classList.remove('open');
                icon.style.transform = 'rotate(0deg)';
            } else {
                // Close others if desired, keeping simple for now
                content.classList.add('open');
                icon.style.transform = 'rotate(180deg)';
            }
        };

        // Init
        loadScenario(0);
    </script>
</Layout>
