---
import Layout from '@layouts/Layout.astro';
---

<Layout
    fullscreen
    title="404 | Oratorium"
    noindex
    bodyClass="bg-[#020205] text-gold-500 h-screen w-screen flex flex-col items-center justify-center m-0 p-0 overflow-hidden"
>

<style is:global>
body { font-family: 'Cinzel', serif; }
</style>
    <div class="text-center relative z-10 animate-pulse-slow">
        <h1 class="text-9xl font-bold opacity-20 select-none">404</h1>
        <p class="text-sm uppercase tracking-[0.5em] mt-8 text-gray-500">Hic Sunt Dracones</p>
        <p class="text-xs text-gray-700 italic mt-2">(Her er drager - Du er faret vild)</p>
        
        <a href="/" class="inline-flex items-center gap-2 mt-12 text-gold-500 hover:text-white transition-colors border-b border-gold-500/30 pb-1">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest">Vend tilbage til Lyset</span>
        </a>
    </div>

    <!-- Background Fog -->
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-gray-800 via-black to-black"></div>

</Layout>
