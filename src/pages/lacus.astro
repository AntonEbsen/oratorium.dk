
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lacus | Refleksionsbassinet</title>
    <meta name="robots" content="noindex, nofollow">
    
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style>
        body { font-family: 'Cinzel', serif; background: #000205; overflow: hidden; }
        
        /* Water Effect */
        .water-bg {
            background: linear-gradient(180deg, #000205 0%, #05101a 100%);
            opacity: 0.8;
        }
        
        .candle {
            position: absolute;
            transition: all 4s cubic-bezier(0.4, 0, 0.2, 1); /* Slow drift */
            cursor: pointer;
            filter: drop-shadow(0 0 10px rgba(255, 160, 0, 0.6));
        }
        
        .candle:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 0 20px rgba(255, 200, 50, 0.8));
            z-index: 10;
        }

        .flame {
            width: 8px;
            height: 12px;
            background: #ffdb4d;
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            box-shadow: 0 0 10px #ff7b00;
            animation: flicker 0.1s infinite alternate;
        }

        .reflection {
            width: 8px;
            height: 20px;
            background: linear-gradient(to bottom, rgba(255, 219, 77, 0.3), transparent);
            margin-top: 2px;
            filter: blur(2px);
            transform: scaleY(-1);
        }

        @keyframes flicker {
            0% { transform: scale(1); opacity: 0.9; }
            100% { transform: scale(1.1); opacity: 1; }
        }

        .ripple {
            position: absolute;
            width: 20px;
            height: 10px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.3);
            animation: ripple-spread 3s ease-out forwards;
            pointer-events: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes ripple-spread {
            0% { width: 10px; height: 5px; opacity: 0.8; }
            100% { width: 300px; height: 150px; opacity: 0; }
        }
        
        /* Message Fade */
        @keyframes float-up {
            0% { transform: translate(-50%, 0); opacity: 0; }
            20% { opacity: 1; }
            100% { transform: translate(-50%, -40px); opacity: 0; }
        }
        .prayer-msg {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
            font-size: 10px;
            color: #ffd700;
            opacity: 0;
            animation: float-up 2s ease-out forwards;
            pointer-events: none;
        }
        
        .me-indicator {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 8px;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 0.2em;
        }

    </style>
</head>
<body class="w-screen h-screen">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Forlad Vandet</span>
        </a>
    </nav>
    
    <!-- Info -->
    <div class="fixed top-8 right-8 z-50 text-right pointer-events-none">
        <h1 class="text-white/80 text-lg tracking-widest uppercase">Lacus</h1>
        <p id="count-display" class="text-[10px] text-white/40 uppercase tracking-[0.3em] transition-opacity duration-1000 opacity-0">... bedende</p>
    </div>

    <!-- The Pool Container -->
    <div id="pool" class="relative w-full h-full overflow-hidden water-bg cursor-crosshair">
        <!-- Floating candles will be injected here -->
    </div>
    
    <audio id="chime" src="/assets/audio/bell.mp3"></audio>

    <script>
        // CLIENT CONFIG (Recycled from Campanile)
        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        
        const pool = document.getElementById('pool');
        const countDisplay = document.getElementById('count-display');
        const chime = document.getElementById('chime');
        
        // My State
        const myId = 'user-' + Math.random().toString(36).substr(2, 9);
        let myPos = { x: Math.random() * 80 + 10, y: Math.random() * 80 + 10 }; // 10-90%
        
        // Supabase
        // @ts-ignore
        const client = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        
        const channel = client.channel('lacus', {
            config: {
                presence: {
                    key: myId,
                },
            },
        });
        
        // Start
        channel
            .on('presence', { event: 'sync' }, () => {
                const state = channel.presenceState();
                renderCandles(state);
            })
            .on('broadcast', { event: 'prayer' }, ({ payload }) => {
                // Someone was prayed for
                showRipple(payload.x, payload.y);
                playChime(0.1); // very quiet
            })
            .subscribe(async (status) => {
                if(status === 'SUBSCRIBED') {
                    // I am online
                    const payload = { 
                        online_at: new Date().toISOString(),
                        x: myPos.x,
                        y: myPos.y
                    };
                    
                    await channel.track(payload);
                    
                    // OPTIMISTIC RENDER: Ensure I see myself immediately
                    // (Sometimes presence sync takes a moment to reflect 'me' back to me)
                    const tempState = channel.presenceState();
                    if(!tempState[myId]) {
                        tempState[myId] = [payload];
                        renderCandles(tempState);
                    }
                    
                    countDisplay.classList.remove('opacity-0');
                    
                    // Simple drift loop (update my pos every 10s)
                    setInterval(async () => {
                        // Drift slightly
                        myPos.x += (Math.random() - 0.5) * 5;
                        myPos.y += (Math.random() - 0.5) * 5;
                        // Clamp
                        if(myPos.x < 5) myPos.x = 5; if(myPos.x > 95) myPos.x = 95;
                        if(myPos.y < 5) myPos.y = 5; if(myPos.y > 95) myPos.y = 95;
                        
                        await channel.track({
                            online_at: new Date().toISOString(),
                            x: myPos.x,
                            y: myPos.y
                        });
                    }, 4000); // Faster drift updates
                }
            });

        function renderCandles(state) {
            pool.innerHTML = ''; // Full redraw (simple for now)
            
            // Count
            let total = 0;
            
            for(const key in state) {
                total++;
                const user = state[key][0]; // get latest state for user
                const isMe = key === myId;
                
                const el = document.createElement('div');
                el.className = 'candle';
                el.style.left = user.x + '%';
                el.style.top = user.y + '%';
                
                let innerHTML = `
                    <div class="flame"></div>
                    <div class="reflection"></div>
                `;
                
                if(isMe) {
                    innerHTML += `<div class="me-indicator">DIG</div>`;
                    el.style.zIndex = '20';
                } else {
                    el.onclick = () => sendPrayer(user.x, user.y);
                    el.title = "Send en bøn";
                }
                
                el.innerHTML = innerHTML;
                pool.appendChild(el);
            }
            
            countDisplay.innerText = `${total} SJÆLE VÅGER`;
        }

        function sendPrayer(x, y) {
            // Visual for me
            showRipple(x, y, true);
            playChime(0.3); 
            
            // Broadcast to others
            channel.send({
                type: 'broadcast',
                event: 'prayer',
                payload: { x, y }
            });
        }
        
        function showRipple(x, y, showText = false) {
            // Find candle at pos or just create at pos
            // Since we redraw, we better just append to pool absolute
            const rip = document.createElement('div');
            rip.className = 'ripple';
            rip.style.left = x + '%';
            rip.style.top = y + '%';
            pool.appendChild(rip);
            
            if(showText) {
                const msg = document.createElement('div');
                msg.className = 'prayer-msg';
                msg.innerText = "Bøn Sendt";
                rip.appendChild(msg); // attach to ripple so it centers
            }
            
            setTimeout(() => rip.remove(), 3000);
        }
        
        function playChime(vol) {
            const clone = chime.cloneNode();
            clone.volume = vol;
            clone.play().catch(e => {});
        }
        
        // Random "Ambient" ripples to make it feel alive if empty?
        // Maybe later.
        
    </script>
</body>
</html>
