
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pilgrimspas | Log Ind</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 flex items-center justify-center min-h-screen">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-md p-8 text-center animate-fade-in-up">
        
        <div class="mb-8 text-gold-500 text-4xl drop-shadow-[0_0_15px_rgba(255,215,0,0.3)]">
            <i class="fa-solid fa-passport"></i>
        </div>
        
        <h1 class="text-2xl text-white mb-2">Pilgrimspas</h1>
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-10 sans">Log ind for at gemme din rejse</p>

        <form id="magic-link-form" class="space-y-6">
            <div>
                 <input 
                    type="email" 
                    id="email" 
                    required 
                    class="w-full bg-white/5 border border-gray-700 rounded p-4 text-center text-white focus:border-gold-500 outline-none transition-colors sans placeholder:text-gray-600"
                    placeholder="din@email.dk"
                >
            </div>
            
            <button type="submit" class="w-full py-4 bg-gold-600/20 border border-gold-500/50 hover:bg-gold-500 hover:text-black text-gold-500 transition-all uppercase tracking-widest text-xs rounded">
                Send Magisk Link
            </button>
        </form>

        <div id="message" class="hidden mt-8 p-4 bg-green-900/20 border border-green-500/30 rounded text-green-400 text-sm sans">
            <i class="fa-solid fa-envelope mr-2"></i> Tjek din indbakke for login-linket.
        </div>

    </div>

    <script>
        // CLIENT CONFIG
        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        
        // @ts-ignore
        const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        const form = document.getElementById('magic-link-form');
        const msg = document.getElementById('message');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            
            // Magic Link Login
            const { error } = await supabase.auth.signInWithOtp({
                email: email,
                options: {
                    emailRedirectTo: window.location.origin + '/profile'
                }
            });

            if (error) {
                alert("Fejl: " + error.message);
            } else {
                form.classList.add('hidden');
                msg.classList.remove('hidden');
            }
        });
        
        // Check if already logged in
        async function checkUser() {
            const { data: { session } } = await supabase.auth.getSession();
            if (session) {
                window.location.href = '/profile';
            }
        }
        checkUser();
    </script>
</body>
</html>
