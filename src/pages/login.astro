---
import Layout from '@layouts/Layout.astro';
---

<Layout
    fullscreen
    title="Pilgrimspas | Log Ind"
    noindex
    bodyClass="selection:bg-gold-500/30 flex items-center justify-center min-h-screen"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
</style>
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-md p-8 text-center animate-fade-in-up">
        
        <div class="mb-8 text-gold-500 text-4xl drop-shadow-[0_0_15px_rgba(255,215,0,0.3)]">
            <i class="fa-solid fa-passport"></i>
        </div>
        
        <h1 class="text-2xl text-white mb-2">Pilgrimspas</h1>
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-10 sans">Adgang til den indre borg</p>

        <form id="auth-form" class="space-y-4">
            <div>
                 <input 
                    type="email" 
                    id="email" 
                    required 
                    class="w-full bg-white/5 border border-gray-700 rounded p-4 text-center text-white focus:border-gold-500 outline-none transition-colors sans placeholder:text-gray-600"
                    placeholder="E-mail"
                >
            </div>
            <div>
                 <input 
                    type="password" 
                    id="password" 
                    required 
                    class="w-full bg-white/5 border border-gray-700 rounded p-4 text-center text-white focus:border-gold-500 outline-none transition-colors sans placeholder:text-gray-600"
                    placeholder="Adgangskode"
                    minlength="6"
                >
            </div>
            
            <div class="flex gap-4 pt-4">
                <button type="submit" id="btn-login" class="flex-1 py-4 bg-gold-600/20 border border-gold-500/50 hover:bg-gold-500 hover:text-black text-gold-500 transition-all uppercase tracking-widest text-xs rounded">
                    Log Ind
                </button>
                <button type="button" id="btn-signup" class="flex-1 py-4 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-400 transition-all uppercase tracking-widest text-xs rounded">
                    Opret
                </button>
            </div>
        </form>

        <p id="error-msg" class="hidden mt-6 text-red-400 text-xs sans uppercase tracking-widest bg-red-900/20 p-2 rounded border border-red-500/20"></p>
        <p id="success-msg" class="hidden mt-6 text-green-400 text-xs sans uppercase tracking-widest bg-green-900/20 p-2 rounded border border-green-500/20">Konto oprettet! Logger ind...</p>

    </div>

    <script>

        // DEBUG DIAGNOSTICS
        console.log("Login Script Starting...");
        
        
        // 2. Initialize
import { supabase as client } from '@lib/supabaseClient';
        console.log("Supabase Client Initialized");

        const form = document.getElementById('auth-form');
        const emailInput = document.getElementById('email');
        const passInput = document.getElementById('password');
        const btnLogin = document.getElementById('btn-login');
        const btnSignup = document.getElementById('btn-signup');
        const errorMsg = document.getElementById('error-msg');
        const successMsg = document.getElementById('success-msg');

        // 3. Check Elements
        if(!form || !emailInput || !passInput || !btnLogin || !btnSignup) {
            alert("KRITISK FEJL: Entelementer mangler på siden. Prøv at genindlæse.");
            console.error("Missing elements", { form, emailInput, passInput, btnLogin, btnSignup });
        }

        // Login Handler
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = emailInput.value;
            const password = passInput.value;
            
            errorMsg.classList.add('hidden');

            const { data, error } = await client.auth.signInWithPassword({
                email, password
            });

            if (error) {
                errorMsg.innerText = "Fejl: " + error.message;
                errorMsg.classList.remove('hidden');
            } else {
                window.location.href = '/profile';
            }
        });

        // Signup Handler
        btnSignup.addEventListener('click', async () => {
             // DEBUG: PROVE BUTTON WORKS
             console.log("Signup Clicked");

             const email = emailInput.value;
             const password = passInput.value;
             
             if(!email || !password) {
                 alert("Udfyld venligst email og adgangskode.");
                 return;
             }
             
             errorMsg.classList.add('hidden');
             btnSignup.innerText = "Opretter...";
             btnSignup.disabled = true;

             try {
                 const { data, error } = await client.auth.signUp({
                    email, password
                });

                if (error) {
                    alert("Supabase Fejl: " + error.message);
                    errorMsg.innerText = "Fejl: " + error.message;
                    errorMsg.classList.remove('hidden');
                } else {
                    if(data.session) {
                        alert("Succes! Du er nu logget ind.");
                        window.location.href = '/profile';
                    } else if(data.user) {
                         alert("Konto oprettet! Tjek om du skal bekræfte email.");
                         errorMsg.innerText = "Konto oprettet. Tjek email.";
                         errorMsg.classList.remove('hidden');
                    }
                }
             } catch (err) {
                 alert("Kritisk Fejl: " + err.message);
             } finally {
                 btnSignup.innerText = "Opret";
                 btnSignup.disabled = false;
             }
        });
        
        // Auto Redirect if logged in
        async function checkUser() {
            try {
                const { data: { session } } = await client.auth.getSession();
                if (session) {
                    console.log("User already logged in");
                     window.location.href = '/profile';
                }
            } catch(e) { console.error("Session check failed", e); }
        }
        checkUser();
    </script>
</Layout>
