
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pilgrimspas | Log Ind</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 flex items-center justify-center min-h-screen">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-md p-8 text-center animate-fade-in-up">
        
        <div class="mb-8 text-gold-500 text-4xl drop-shadow-[0_0_15px_rgba(255,215,0,0.3)]">
            <i class="fa-solid fa-passport"></i>
        </div>
        
        <h1 class="text-2xl text-white mb-2">Pilgrimspas</h1>
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-10 sans">Adgang til den indre borg</p>

        <form id="auth-form" class="space-y-4">
            <div>
                 <input 
                    type="email" 
                    id="email" 
                    required 
                    class="w-full bg-white/5 border border-gray-700 rounded p-4 text-center text-white focus:border-gold-500 outline-none transition-colors sans placeholder:text-gray-600"
                    placeholder="E-mail"
                >
            </div>
            <div>
                 <input 
                    type="password" 
                    id="password" 
                    required 
                    class="w-full bg-white/5 border border-gray-700 rounded p-4 text-center text-white focus:border-gold-500 outline-none transition-colors sans placeholder:text-gray-600"
                    placeholder="Adgangskode"
                    minlength="6"
                >
            </div>
            
            <div class="flex gap-4 pt-4">
                <button type="submit" id="btn-login" class="flex-1 py-4 bg-gold-600/20 border border-gold-500/50 hover:bg-gold-500 hover:text-black text-gold-500 transition-all uppercase tracking-widest text-xs rounded">
                    Log Ind
                </button>
                <button type="button" id="btn-signup" class="flex-1 py-4 bg-white/5 border border-white/10 hover:bg-white/10 text-gray-400 transition-all uppercase tracking-widest text-xs rounded">
                    Opret
                </button>
            </div>
        </form>

        <p id="error-msg" class="hidden mt-6 text-red-400 text-xs sans uppercase tracking-widest bg-red-900/20 p-2 rounded border border-red-500/20"></p>
        <p id="success-msg" class="hidden mt-6 text-green-400 text-xs sans uppercase tracking-widest bg-green-900/20 p-2 rounded border border-green-500/20">Konto oprettet! Logger ind...</p>

    </div>

    <script>
        // CLIENT CONFIG
        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        
        // @ts-ignore
        const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        const form = document.getElementById('auth-form');
        const emailInput = document.getElementById('email');
        const passInput = document.getElementById('password');
        const btnLogin = document.getElementById('btn-login');
        const btnSignup = document.getElementById('btn-signup');
        const errorMsg = document.getElementById('error-msg');
        const successMsg = document.getElementById('success-msg');

        // Login Handler
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = emailInput.value;
            const password = passInput.value;
            
            errorMsg.classList.add('hidden');

            const { data, error } = await supabase.auth.signInWithPassword({
                email, password
            });

            if (error) {
                errorMsg.innerText = "Fejl: " + error.message;
                errorMsg.classList.remove('hidden');
            } else {
                window.location.href = '/profile';
            }
        });

        // Signup Handler
        btnSignup.addEventListener('click', async () => {
             const email = emailInput.value;
             const password = passInput.value;
             
             if(!email || !password) {
                 errorMsg.innerText = "Udfyld venligst email og adgangskode.";
                 errorMsg.classList.remove('hidden');
                 return;
             }
             
             errorMsg.classList.add('hidden');
             btnSignup.innerText = "Opretter...";
             btnSignup.disabled = true;

             const { data, error } = await supabase.auth.signUp({
                email, password
            });
            
            btnSignup.innerText = "Opret";
            btnSignup.disabled = false;

            if (error) {
                console.error("Signup Error:", error);
                errorMsg.innerText = "Fejl: " + (error.message || error.error_description || "Kunne ikke oprette bruger.");
                errorMsg.classList.remove('hidden');
            } else {
                console.log("Signup Success:", data);
                if(data.session) {
                    // Success + Logged In
                    successMsg.innerText = "Konto oprettet! Logger ind...";
                    successMsg.classList.remove('hidden');
                    setTimeout(() => window.location.href = '/profile', 1000);
                } else if(data.user && !data.session) {
                     // Success BUT Email Confirmation Required
                     errorMsg.innerText = "Konto oprettet, MEN du skal bekræfte din email først. (Tjek din indbakke eller slå 'Confirm Email' fra i Supabase).";
                     errorMsg.classList.remove('hidden');
                     errorMsg.classList.replace('text-red-400', 'text-yellow-400');
                     errorMsg.classList.replace('bg-red-900/20', 'bg-yellow-900/20');
                }
            }
        });
        
        // Auto Redirect if logged in
        async function checkUser() {
            const { data: { session } } = await supabase.auth.getSession();
            if (session) {
                window.location.href = '/profile';
            }
        }
        checkUser();
    </script>
</body>
</html>
