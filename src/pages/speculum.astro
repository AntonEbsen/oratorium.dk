---
import Layout from '@layouts/Layout.astro';

// The five movements of the Ignatian Daily Examen — a "mirror" (speculum) held
// up to the day. Distinct from the sacramental examination at /confession.
const steps = [
    {
        num: 'I',
        latin: 'Gratiarum Actio',
        title: 'Taksigelse',
        icon: 'fa-hands-holding-heart',
        body: 'Begynd med tak. Se tilbage på dagen som en gave. Hvad er jeg taknemmelig for — store ting og små, et måltid, et ord, et glimt af lys?',
    },
    {
        num: 'II',
        latin: 'Petitio Luminis',
        title: 'Bøn om lys',
        icon: 'fa-sun',
        body: 'Bed Helligånden om at se dagen, som Gud ser den. Ikke for at anklage mig selv, men for at se klart — i sandhedens milde lys.',
    },
    {
        num: 'III',
        latin: 'Examen',
        title: 'Gennemgang af dagen',
        icon: 'fa-clock-rotate-left',
        body: 'Vandr gennem dagen, time for time. Hvor var Gud nærværende? Hvornår fulgte jeg kærligheden — og hvornår vendte jeg mig bort fra den?',
    },
    {
        num: 'IV',
        latin: 'Contritio',
        title: 'Anger og tilgivelse',
        icon: 'fa-dove',
        body: 'Hvor jeg fejlede, beder jeg om tilgivelse. Hvor jeg blev såret, vælger jeg at tilgive. Jeg lægger dagens vægt i Hans hænder.',
    },
    {
        num: 'V',
        latin: 'Propositum',
        title: 'Forsæt for i morgen',
        icon: 'fa-seedling',
        body: 'Jeg ser fremad med håb. Med Guds nåde — hvad vil jeg gøre anderledes i morgen? Jeg slutter med Fadervor og overgiver natten til Ham.',
    },
];
---

<Layout
    title="Speculum | Det Daglige Examen"
    description="Speculum — det daglige Examen. En stille, ignatiansk samvittighedsransagelse i fem trin: hold dagen som et spejl op mod Guds lys, og gå til ro i fred."
    extraFonts={['Playfair+Display:ital,wght@0,400;0,700;1,400']}
    bodyClass="min-h-screen flex flex-col"
>
    <style>
        .text-body { font-family: 'Playfair Display', serif; }
        .step-line::before {
            content: '';
            position: absolute;
            left: 2.25rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.35), transparent);
        }
    </style>

    <!-- Navigation -->
    <nav class="fixed top-8 left-8 z-50">
        <a
            href="/"
            class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans"
        >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage til Helligdommen</span>
        </a>
    </nav>

    <!-- Ambient glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[36rem] h-[36rem] bg-gold-500/5 rounded-full blur-[140px] pointer-events-none"></div>

    <!-- Hero -->
    <header class="relative text-center px-6 pt-36 pb-20 max-w-2xl mx-auto">
        <p class="text-[10px] uppercase tracking-[0.5em] text-gold-500/50 mb-6">Speculum</p>
        <h1 class="text-5xl md:text-6xl text-gold-200 font-serif mb-8 drop-shadow-[0_0_25px_rgba(212,175,55,0.25)]">
            Det Daglige Examen
        </h1>
        <p class="text-body text-gray-400 text-lg italic leading-relaxed mb-4">
            "Ransag mig, Gud, og kend mit hjerte, prøv mig, og kend mine tanker." — Salme 139,23
        </p>
        <p class="text-gray-500 sans text-sm leading-relaxed max-w-lg mx-auto">
            En stille bøn ved dagens ende. Den hellige Ignatius af Loyola kaldte den
            dagens vigtigste øvelse: at holde de forgangne timer op som et spejl —
            <em>speculum</em> — mod Guds milde lys.
        </p>
    </header>

    <!-- The Five Movements -->
    <main class="relative max-w-2xl mx-auto px-6 pb-24 w-full">
        <ol class="relative step-line space-y-12 list-none">
            {steps.map((step) => (
                <li class="relative flex gap-8 items-start">
                    <div class="relative z-10 shrink-0 w-[4.5rem] flex flex-col items-center">
                        <div class="w-[4.5rem] h-[4.5rem] rounded-full bg-[#0a0a0c] border border-gold-500/40 flex items-center justify-center text-gold-500 shadow-[0_0_20px_rgba(212,175,55,0.15)]">
                            <i class={`fa-solid ${step.icon} text-2xl`} aria-hidden="true"></i>
                        </div>
                        <span class="mt-3 text-xs text-gold-500/60 font-serif tracking-widest">{step.num}</span>
                    </div>
                    <div class="pt-2">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-gold-500/50 mb-1">{step.latin}</p>
                        <h2 class="text-2xl text-gold-100 font-serif mb-3">{step.title}</h2>
                        <p class="text-body text-gray-400 leading-relaxed">{step.body}</p>
                    </div>
                </li>
            ))}
        </ol>

        <!-- Closing -->
        <div class="mt-20 text-center border-t border-gold-900/40 pt-16">
            <p class="text-body text-gray-400 italic text-lg mb-8 leading-relaxed">
                "I dine hænder, Herre, betror jeg min ånd."
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/prayers"
                    class="inline-block px-8 py-3 border border-gold-500/40 text-gold-400 hover:bg-gold-500 hover:text-black uppercase text-xs tracking-[0.2em] transition-all rounded-sm"
                >
                    Aftenbønner
                </a>
                <a
                    href="/confession"
                    class="inline-block px-8 py-3 border border-white/10 text-gray-400 hover:border-gold-500/40 hover:text-gold-200 uppercase text-xs tracking-[0.2em] transition-all rounded-sm"
                >
                    Samvittighedens Spejl
                </a>
            </div>
        </div>
    </main>
</Layout>
