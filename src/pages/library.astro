---
import Layout from '@layouts/Layout.astro';
import { libraryBooks } from '../utils/library';
---

<Layout
    title="Biblioteket | Ad Majorem Dei Gloriam"
    extraFonts={["Playfair+Display:ital,wght@0,400;0,700;1,400"]}
    noindex
    bodyClass="bg-[#08080a] text-gray-300 min-h-screen w-screen overflow-x-hidden m-0 p-0 selection:bg-gold-500/30"
>

<style is:global>
body { font-family: 'Cinzel', serif; }
        .text-body { font-family: 'Playfair Display', serif; }
        .sans { font-family: 'Inter', sans-serif; }
</style>
    <!-- Background -->
    <div class="fixed inset-0 z-0 pointer-events-none bg-gradient-to-b from-[#15151a] via-[#050508] to-black">
         <div class="absolute inset-0 opacity-10" style="background-image: url('https://www.transparenttextures.com/patterns/wood-pattern.png');"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 w-full min-h-screen flex flex-col items-center pt-24 pb-24 px-8 max-w-6xl mx-auto">
        
        <!-- Header -->
        <div class="text-center mb-16 animate-fade-in-up">
            <h1 class="text-3xl md:text-5xl text-gold-100 font-bold tracking-wide mb-4">Biblioteket</h1>
            <p class="text-xs text-gold-500/60 uppercase tracking-[0.3em] sans">Visdommens Kilde</p>
        </div>

        <!-- Bookshelf Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 w-full">
            {libraryBooks.map((book, index) => (
                <div class="group relative perspective-1000 animate-fade-in-up" style={`animation-delay: ${index * 0.1}s`}>
                    <!-- Book Spine/Cover -->
                    <div class={`relative h-64 md:h-80 w-full rounded-tr-md rounded-br-md shadow-[5px_5px_15px_rgba(0,0,0,0.5)] transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-[10px_10px_30px_rgba(0,0,0,0.6)] overflow-hidden cursor-pointer book-card ${book.coverColor}`}>
                        
                        <!-- Texture -->
                        <div class="absolute inset-0 opacity-20 mix-blend-multiply bg-[url('https://www.transparenttextures.com/patterns/leather.png')]"></div>
                        
                        <!-- Spine Detail (Left side) -->
                        <div class="absolute left-0 top-0 bottom-0 w-8 bg-black/20 border-r border-white/5"></div>
                        
                        <!-- Bookmark Toggle -->
                        <button class="bookmark-btn absolute top-2 right-2 z-20 p-2" data-id={book.id}>
                            <i class="fa-regular fa-bookmark text-white/50 hover:text-gold-500"></i>
                        </button>
                        
                        <!-- Title -->
                        <div class="absolute top-8 left-12 right-4">
                            <h3 class="text-gold-100 text-lg md:text-xl font-bold leading-tight drop-shadow-md border-b border-gold-500/30 pb-2">
                                {book.title}
                            </h3>
                            <p class="text-gold-500/80 text-xs uppercase tracking-widest mt-2 font-mono">
                                {book.author}
                            </p>
                        </div>

                         <!-- Year -->
                         <div class="absolute bottom-4 right-4 text-xs text-white/30 font-mono">
                            {book.year}
                         </div>

                    </div>

                    <!-- Description Reveal (Tooltip-ish or Expansion) -->
                    <div class="absolute inset-x-0 top-full mt-4 p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none md:pointer-events-auto bg-black/80 border border-gold-500/20 rounded text-center z-20">
                        <p class="text-sm text-gray-400 text-body italic leading-relaxed">
                            "{book.description}"
                        </p>
                    </div>
                </div>
            ))}
        </div>

    </main>
    
    <div id="toast" class="fixed bottom-8 right-8 bg-gold-600 text-black px-6 py-3 rounded shadow-lg transform translate-y-20 transition-transform duration-300 z-50 font-serif">
        Bogen er gemt i dit Scriptorium
    </div>

    <script>

import { supabase as client } from '@lib/supabaseClient';

        const toast = document.getElementById('toast');
        let currentUser = null;
        let myBookmarks = new Set();

        async function init() {
            const { data: { session } } = await client.auth.getSession();
            currentUser = session?.user;

            if(currentUser) {
                // Fetch existing bookmarks
                const { data } = await client.from('bookmarks').select('book_id').eq('user_id', currentUser.id);
                if(data) {
                    data.forEach(b => myBookmarks.add(b.book_id));
                    updateUI();
                }
            }
        }

        function updateUI() {
            document.querySelectorAll('.bookmark-btn').forEach((btn: any) => {
                const id = btn.dataset.id;
                if(myBookmarks.has(id)) {
                    btn.innerHTML = '<i class="fa-solid fa-bookmark text-gold-500"></i>';
                } else {
                    btn.innerHTML = '<i class="fa-regular fa-bookmark text-white/50 hover:text-gold-500"></i>';
                }
            });
        }

        // Attach listeners globally (delegation or direct)
        // Since buttons are rendered by Astro server-side, we can just select them.
        setTimeout(() => {
             document.querySelectorAll('.bookmark-btn').forEach(btn => {
                 btn.addEventListener('click', async (e) => {
                     e.preventDefault();
                     e.stopPropagation();
                     
                     if(!currentUser) {
                         alert("Log ind for at gemme bøger.");
                         window.location.href = '/login';
                         return;
                     }

                     const bookId = (btn as HTMLElement).dataset.id;
                     
                     if(myBookmarks.has(bookId)) {
                         // Remove
                         await client.from('bookmarks').delete().match({ user_id: currentUser.id, book_id: bookId });
                         myBookmarks.delete(bookId);
                         showToast("Bogen er fjernet fra Scriptorium");
                     } else {
                         // Add
                         await client.from('bookmarks').insert([{ user_id: currentUser.id, book_id: bookId }]);
                         myBookmarks.add(bookId);
                         showToast("Bogen er gemt i dit Scriptorium");
                     }
                     updateUI();
                 });
             });
        }, 500); // Small delay to ensure DOM

        function showToast(msg) {
            if(toast) {
                toast.innerText = msg;
                toast.classList.remove('translate-y-20');
                setTimeout(() => toast.classList.add('translate-y-20'), 3000);
            }
        }

        init();
    </script>
</Layout>
