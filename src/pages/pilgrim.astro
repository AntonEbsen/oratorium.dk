---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Pilgrimsrejser | Oratorium"
    description="Pilgrimsrejser og danske helligdomme — find vej til Åsebakken, Øm Kloster og andre hellige steder i Danmark."
    extraFonts={["Playfair+Display:ital@0;1"]}
    bodyClass="selection:bg-green-800/30 min-h-screen flex flex-col pt-32"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #050508; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
        
        .map-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
</style>
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/seek" class="text-green-600 hover:text-green-400 transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>
    
    <!-- Header -->
    <header class="text-center mb-16 px-4">
        <div class="w-16 h-16 mx-auto bg-green-900/10 rounded-full flex items-center justify-center text-green-600 text-2xl mb-6 border border-green-600/20">
            <i class="fa-solid fa-map-location-dot"></i>
        </div>
        <h1 class="text-3xl md:text-5xl text-green-600 mb-6 font-serif drop-shadow-lg">Helligdomme i Danmark</h1>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans max-w-lg mx-auto leading-loose">
            Hellig jord under vore fødder.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-5xl mx-auto px-6 pb-32">
        
        <div class="space-y-12">
            
            <!-- 1. Åsebakken -->
            <article class="map-card bg-[#101510] border border-white/5 rounded-xl overflow-hidden flex flex-col md:flex-row transition-all duration-300 group">
                <div class="md:w-1/3 bg-green-900/20 relative min-h-[200px]">
                    <!-- Image Placeholder -->
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/nature.png')] opacity-30"></div>
                     <div class="absolute inset-0 flex items-center justify-center">
                        <i class="fa-solid fa-person-praying text-5xl text-green-600/50"></i>
                    </div>
                </div>
                <div class="p-8 md:w-2/3">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                             <h2 class="text-2xl text-white font-serif mb-1 group-hover:text-green-500 transition-colors">Vor Frue af Åsebakken</h2>
                             <p class="text-[10px] text-green-600 uppercase tracking-widest">Birkerød, Nordsjælland</p>
                        </div>
                        <i class="fa-solid fa-compass text-green-800 text-2xl"></i>
                    </div>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Danmarks nationale valfartssted. Hvert år vandrer tusinder hertil for at ære Jomfru Maria. Klosteret høres af Benediktinerinder.
                    </p>
                    <div class="flex gap-4">
                         <a href="https://www.google.com/maps/search/?api=1&query=Vor+Frue+Kloster+Åsebakken" target="_blank" class="text-xs uppercase tracking-widest text-white/50 hover:text-white border-b border-white/20 pb-1">
                            <i class="fa-solid fa-location-arrow mr-1"></i> Find vej
                        </a>
                        <span class="text-xs text-green-600/50 uppercase tracking-widest">
                            <i class="fa-solid fa-calendar mr-1"></i> Store Valfarter: Maj & September
                        </span>
                    </div>
                </div>
            </article>

            <!-- 2. Øm Kloster -->
            <article class="map-card bg-[#101510] border border-white/5 rounded-xl overflow-hidden flex flex-col md:flex-row transition-all duration-300 group">
                <div class="md:w-1/3 bg-green-900/20 relative min-h-[200px]">
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stone.png')] opacity-30"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <i class="fa-solid fa-dungeon text-5xl text-green-600/50"></i>
                    </div>
                </div>
                <div class="p-8 md:w-2/3">
                     <div class="flex justify-between items-start mb-4">
                        <div>
                             <h2 class="text-2xl text-white font-serif mb-1 group-hover:text-green-500 transition-colors">Øm Kloster</h2>
                             <p class="text-[10px] text-green-600 uppercase tracking-widest">Rye, Jylland</p>
                        </div>
                         <i class="fa-solid fa-compass text-green-800 text-2xl"></i>
                    </div>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Ruinerne af et mægtigt cistercienserkloster ("Cara Insula"). Her mærker man historiens vingesus og bønnerne fra middelalderens munke.
                    </p>
                     <div class="flex gap-4">
                         <a href="https://www.google.com/maps/search/?api=1&query=Øm+Kloster+Museum" target="_blank" class="text-xs uppercase tracking-widest text-white/50 hover:text-white border-b border-white/20 pb-1">
                            <i class="fa-solid fa-location-arrow mr-1"></i> Find vej
                        </a>
                    </div>
                </div>
            </article>

            <!-- 3. Skt. Ansgars Kirke (Cathedral) -->
            <article class="map-card bg-[#101510] border border-white/5 rounded-xl overflow-hidden flex flex-col md:flex-row transition-all duration-300 group">
                <div class="md:w-1/3 bg-green-900/20 relative min-h-[200px]">
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/brick-wall.png')] opacity-30"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <i class="fa-solid fa-church text-5xl text-green-600/50"></i>
                    </div>
                </div>
                <div class="p-8 md:w-2/3">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                             <h2 class="text-2xl text-white font-serif mb-1 group-hover:text-green-500 transition-colors">Skt. Ansgars Domkirke</h2>
                             <p class="text-[10px] text-green-600 uppercase tracking-widest">Bredgade, København</p>
                        </div>
                         <i class="fa-solid fa-compass text-green-800 text-2xl"></i>
                    </div>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Hovedkirken for alle katolikker i Danmark. Dedikeret til Nordens Apostel, Ansgar. Her opbevares relikvier og her fejres de største højtider.
                    </p>
                     <div class="flex gap-4">
                         <a href="https://www.google.com/maps/search/?api=1&query=Sankt+Ansgars+Kirke+København" target="_blank" class="text-xs uppercase tracking-widest text-white/50 hover:text-white border-b border-white/20 pb-1">
                            <i class="fa-solid fa-location-arrow mr-1"></i> Find vej
                        </a>
                    </div>
                </div>
            </article>
            
             <!-- 4. Sostrup Slot / Maria Hjerte -->
            <article class="map-card bg-[#101510] border border-white/5 rounded-xl overflow-hidden flex flex-col md:flex-row transition-all duration-300 group">
                <div class="md:w-1/3 bg-green-900/20 relative min-h-[200px]">
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/flowers.png')] opacity-30"></div>
                     <div class="absolute inset-0 flex items-center justify-center">
                        <i class="fa-solid fa-leaf text-5xl text-green-600/50"></i>
                    </div>
                </div>
                <div class="p-8 md:w-2/3">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                             <h2 class="text-2xl text-white font-serif mb-1 group-hover:text-green-500 transition-colors">Sostrup & Maria Hjerte</h2>
                             <p class="text-[10px] text-green-600 uppercase tracking-widest">Djursland</p>
                        </div>
                        <i class="fa-solid fa-compass text-green-800 text-2xl"></i>
                    </div>
                    <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                        Tidligere Cistercienserinde-kloster. Kirken "Maria Hjerte" er stadig et vigtigt åndeligt sted med en særlig atmosfære af stilhed.
                    </p>
                    <div class="flex gap-4">
                         <a href="https://www.google.com/maps/search/?api=1&query=Sostrup+Slot" target="_blank" class="text-xs uppercase tracking-widest text-white/50 hover:text-white border-b border-white/20 pb-1">
                            <i class="fa-solid fa-location-arrow mr-1"></i> Find vej
                        </a>
                    </div>
                </div>
            </article>

        </div>

    </main>

</Layout>
