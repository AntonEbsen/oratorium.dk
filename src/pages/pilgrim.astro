
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pilgrimsprofil | Oratorium</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col items-center pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <button onclick="history.back()" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </button>
    </nav>

    <div id="profile-container" class="w-full max-w-2xl px-6 text-center pb-20">
        <!-- Loading -->
        <div id="loading" class="animate-pulse">
            <div class="h-8 w-48 bg-gray-800 mx-auto rounded mb-4"></div>
            <div class="h-4 w-32 bg-gray-900 mx-auto rounded"></div>
        </div>
    </div>

    <!-- Message Modal -->
    <div id="msg-modal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-gold-500/30 p-8 rounded max-w-md w-full relative">
            <button onclick="toggleMsg()" class="absolute top-4 right-4 text-gray-500 hover:text-white"><i class="fa-solid fa-times"></i></button>
            <h3 class="text-gold-500 mb-2 font-serif text-xl">Send Besked</h3>
            <p id="msg-recipient" class="text-xs text-gray-500 uppercase tracking-widest mb-6">Til: ...</p>
            
            <textarea id="msg-content" rows="4" class="w-full bg-black/50 border border-gray-700 rounded p-3 text-white mb-4 focus:border-gold-500 outline-none resize-none font-sans" placeholder="Din besked..."></textarea>
            
            <button id="send-btn" class="w-full bg-gold-600/20 text-gold-500 border border-gold-500/50 py-2 rounded uppercase text-xs tracking-widest hover:bg-gold-500 hover:text-black transition-colors">
                Send
            </button>
        </div>
    </div>

    <script>
        import { createClient } from '@supabase/supabase-js';

        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        const client = createClient(SUPABASE_URL, SUPABASE_KEY);

        const container = document.getElementById('profile-container');
        const loading = document.getElementById('loading');
        const modal = document.getElementById('msg-modal');
        const msgRecipient = document.getElementById('msg-recipient');
        const msgContent = document.getElementById('msg-content');
        const sendBtn = document.getElementById('send-btn');

        let targetUserId = null;
        let targetUserName = "Anonym";

        async function init() {
            // Get ID from URL
            const urlParams = new URLSearchParams(window.location.search);
            const id = urlParams.get('id');

            if(!id) {
                container.innerHTML = '<p class="text-red-500 mt-10">Ingen bruger angivet.</p>';
                return;
            }

            targetUserId = id;

            // Fetch Target Profile
            const { data: profile, error } = await client
                .from('profiles')
                .select('*')
                .eq('id', id)
                .single();

            if(error || !profile) {
                 container.innerHTML = '<p class="text-gray-500 mt-10">Brugeren blev ikke fundet.</p>';
                 return;
            }

            // Determine Name
            if (profile.first_name || profile.last_name) {
                targetUserName = `${profile.first_name || ''} ${profile.last_name || ''}`.trim();
            } else if (profile.username) {
                targetUserName = profile.username;
            }

            msgRecipient.innerText = `Til: ${targetUserName}`;

            // Render Profile
            loading.remove();
            
            const joinDate = new Date(profile.created_at).toLocaleDateString('da-DK', { year: 'numeric', month: 'long' });

            const streakHtml = profile.prayer_streak > 0 
                ? `<div class="p-4 bg-orange-900/10 border border-orange-500/30 rounded inline-block text-orange-400 mb-6">
                     <i class="fa-solid fa-fire mr-2"></i> ${profile.prayer_streak} Dages Streak
                   </div>` 
                : '';

            const roseHtml = profile.rosary_count > 0
                ? `<div class="p-4 bg-red-900/10 border border-red-500/30 rounded inline-block text-red-400 mb-6 mx-2">
                     <i class="fa-solid fa-rose mr-2"></i> ${profile.rosary_count} Roser
                   </div>`
                : '';

            container.innerHTML = `
                <div class="mb-4">
                    <div class="w-24 h-24 bg-gold-900/20 border border-gold-500/30 rounded-full mx-auto flex items-center justify-center text-gold-500 text-3xl mb-4">
                        <i class="fa-solid fa-user"></i>
                    </div>
                </div>
                
                <h1 class="text-3xl md:text-5xl text-gold-500 mb-2 font-serif">${targetUserName}</h1>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-8 sans">Rejse startet ${joinDate}</p>

                <div class="flex justify-center flex-wrap gap-2 mb-8">
                    ${streakHtml}
                    ${roseHtml}
                </div>

                <button onclick="toggleMsg()" class="mb-16 px-8 py-3 bg-white/5 border border-white/20 hover:bg-gold-600 hover:text-black hover:border-gold-500 transition-colors uppercase tracking-widest text-xs rounded">
                    <i class="fa-regular fa-envelope mr-2"></i> Send Besked
                </button>

                <!-- ACTIVITY FEED -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
                    
                    <!-- Prayers -->
                    <div class="bg-gray-900/30 border border-white/5 p-6 rounded">
                        <h3 class="text-gold-500/70 border-b border-white/5 pb-2 mb-4 font-serif">Bønner</h3>
                        <div id="public-prayers" class="space-y-4">
                            <p class="text-gray-600 text-xs italic">Indlæser...</p>
                        </div>
                    </div>

                    <!-- Testimonies -->
                    <div class="bg-gray-900/30 border border-white/5 p-6 rounded">
                       <h3 class="text-gold-500/70 border-b border-white/5 pb-2 mb-4 font-serif">Vidnesbyrd</h3>
                       <div id="public-testimonies" class="space-y-4">
                            <p class="text-gray-600 text-xs italic">Indlæser...</p>
                       </div>
                    </div>

                </div>
            `;
            
            // Load Public Content
            loadPublicActivity(id);
        }

        async function loadPublicActivity(id) {
            // Prayers
            const { data: prayers } = await client
                .from('prayers')
                .select('*')
                .eq('user_id', id)
                .eq('approved', true) // Only approved public prayers
                .order('created_at', { ascending: false })
                .limit(3);
                
            const pContainer = document.getElementById('public-prayers');
            if(prayers && prayers.length > 0) {
                pContainer.innerHTML = prayers.map(p => `
                    <div class="text-sm text-gray-400 italic">"${p.content}"</div>
                `).join('');
            } else {
                pContainer.innerHTML = '<p class="text-gray-600 text-xs italic">Ingen offentlige bønner.</p>';
            }

            // Testimonies
            const { data: testi } = await client
                .from('testimonies')
                .select('*')
                .eq('user_id', id)
                .eq('approved', true)
                .order('created_at', { ascending: false })
                .limit(3);

            const tContainer = document.getElementById('public-testimonies');
            if(testi && testi.length > 0) {
                tContainer.innerHTML = testi.map(t => `
                    <div class="mb-4">
                        <div class="text-gold-500/50 text-xs uppercase tracking-wide mb-1">${t.name}</div>
                        <div class="text-sm text-gray-400 leading-relaxed line-clamp-3">"${t.content}"</div>
                    </div>
                `).join('');
            } else {
                tContainer.innerHTML = '<p class="text-gray-600 text-xs italic">Ingen offentlige vidnesbyrd.</p>';
            }
        }

        // --- MESSAGING ---
        window.toggleMsg = async () => {
             // Check auth first
             const { data: { session } } = await client.auth.getSession();
             if(!session) {
                 alert("Log ind for at sende beskeder.");
                 return;
             }
             modal.classList.toggle('hidden');
        };

        sendBtn.addEventListener('click', async () => {
             const content = (msgContent as HTMLTextAreaElement).value;
             if(!content.trim()) return;

             sendBtn.innerText = "Sender...";

             const { data: { session } } = await client.auth.getSession();
             
             const { error } = await client.from('messages').insert([{
                 sender_id: session.user.id,
                 receiver_id: targetUserId,
                 content: content
             }]);

             if(error) {
                 alert("Fejl: " + error.message);
                 sendBtn.innerText = "Send";
             } else {
                 alert("Besked sendt.");
                 modal.classList.add('hidden');
                 (msgContent as HTMLTextAreaElement).value = ''; // clear
                 sendBtn.innerText = "Send";
             }
        });

        init();
    </script>
</body>
</html>
