
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campanile | Klokketårnet</title>
    <meta name="robots" content="noindex, nofollow">
    
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Supabase Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style>
        body { font-family: 'Cinzel', serif; }
        
        .rope-container {
            transform-origin: top center;
            transition: transform 0.2s cubic-bezier(0.4, 2.0, 0.4, 1.0); /* Elastic bounce */
        }
        
        .rope-pulled {
            transform: scaleY(1.3);
        }

        .bell-shake {
            animation: shake 2s ease-in-out;
        }

        @keyframes shake {
            0% { transform: rotate(0deg); }
            10% { transform: rotate(15deg); }
            30% { transform: rotate(-10deg); }
            50% { transform: rotate(5deg); }
            70% { transform: rotate(-2deg); }
            100% { transform: rotate(0deg); }
        }
        
        /* Particle Ripple for remote rings */
        @keyframes server-ring {
            0% { transform: scale(1); opacity: 0.8; border-color: #FFD700; }
            100% { transform: scale(4); opacity: 0; border-color: transparent; }
        }
        .remote-ring {
            position: absolute;
            width: 100px;
            height: 100px;
            border: 2px solid #FFD700;
            border-radius: 50%;
            animation: server-ring 2s ease-out forwards;
        }
    </style>
</head>
<body class="bg-[#050505] text-white h-screen w-screen overflow-hidden flex flex-col items-center justify-center relative">

    <!-- Brick Texture -->
    <div class="absolute inset-0 z-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/brick-wall-dark.png')]"></div>
    
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Forlad Tårnet</span>
        </a>
    </nav>
    
    <!-- Status -->
    <div class="fixed top-8 right-8 z-50 text-right">
        <div class="flex items-center gap-2 text-white/30 text-xs uppercase tracking-widest">
            <div id="connection-dot" class="w-2 h-2 rounded-full bg-red-500 transition-colors"></div>
            <span id="status-text">Forbinder...</span>
        </div>
        <div id="count-display" class="text-[10px] text-white/20 mt-1 opacity-0 transition-opacity">
            0 Bedende til stede
        </div>
    </div>

    <!-- MAIN INTERACTION -->
    <div class="relative z-10 flex flex-col items-center h-full pt-20">
        
        <!-- The Bell (Visual Only) -->
        <div class="mb-0 text-gold-500/20 text-9xl transform origin-top" id="bell-visual">
            <i class="fa-solid fa-bell"></i>
        </div>

        <!-- The Rope -->
        <!-- We extend the rope to the bottom -->
        <div class="flex-1 flex flex-col items-center cursor-pointer group" id="rope-trigger">
            <!-- Rope Line -->
            <div class="w-1 md:w-2 bg-[#3d3220] h-full rope-container relative flex flex-col items-center shadow-lg group-hover:bg-[#5c4d32] transition-colors" id="rope">
                <!-- Texture -->
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagmonds-light.png')] opacity-30"></div>
                
                <!-- The Knot (Handle) -->
                 <div class="absolute bottom-1/3 w-4 h-6 md:w-6 md:h-10 bg-[#3d3220] rounded-full shadow-xl group-hover:bg-[#5c4d32] transition-colors"></div>
            </div>
        </div>
        
        <p class="absolute bottom-12 text-xs text-white/20 uppercase tracking-[0.3em] pointer-events-none animate-pulse">
            Træk for at kalde
        </p>

    </div>
    
    <!-- Ripples Container -->
    <div id="ripples" class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden"></div>

    <audio id="bell-audio" src="/assets/audio/bell.mp3" preload="auto"></audio>

    <script>
        // CLIENT CONFIG
        // CLIENT CONFIG
        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';

        
        const audio = document.getElementById('bell-audio');
        const rope = document.getElementById('rope');
        const bellVisual = document.getElementById('bell-visual');
        const ripples = document.getElementById('ripples');
        const statusText = document.getElementById('status-text');
        const connDot = document.getElementById('connection-dot');
        const trigger = document.getElementById('rope-trigger');
        const countDisplay = document.getElementById('count-display');

        function playBell() {
            // Random pitch shift slightly for realism?
            const clone = audio.cloneNode();
            clone.volume = 0.6;
            clone.play().catch(e => console.log("Audio ignored", e));
            
            // Visuals
            bellVisual.classList.remove('bell-shake');
            void bellVisual.offsetWidth; // trigger reflow
            bellVisual.classList.add('bell-shake');
            
            // Ripple
            const ripple = document.createElement('div');
            ripple.className = 'remote-ring';
            ripple.style.left = (Math.random() * 80 + 10) + '%'; // Random pos
            ripple.style.top = (Math.random() * 80 + 10) + '%';
            ripples.appendChild(ripple);
            setTimeout(() => ripple.remove(), 2000);
        }

        // --- REALTIME LOGIC ---
        // @ts-ignore
        const client = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        
        const channel = client.channel('campanile', {
            config: {
                presence: {
                    key: 'user-' + Math.random().toString(36).substr(2, 9),
                },
            },
        });

        channel
            .on('broadcast', { event: 'ring' }, (payload) => {
                console.log('Bell rung remotely!');
                playBell();
            })
            .on('presence', { event: 'sync' }, () => {
                const state = channel.presenceState();
                const count = Object.keys(state).length;
                countDisplay.innerText = `${count} Bedende til stede`;
                countDisplay.classList.remove('opacity-0');
            })
            .subscribe((status) => {
                if(status === 'SUBSCRIBED') {
                    connDot.classList.remove('bg-red-500');
                    connDot.classList.add('bg-green-500');
                    statusText.innerText = "Forbundet";
                    
                    // Track presence
                    channel.track({ online_at: new Date().toISOString() });
                } else {
                    connDot.classList.add('bg-red-500');
                    connDot.classList.remove('bg-green-500');
                    statusText.innerText = "Forbinder...";
                }
            });

        // Local User Pulls Rope
        trigger.addEventListener('mousedown', () => {
            // physics
            rope.classList.add('rope-pulled');
            
            // Play sound locally immediately
            playBell();
            
            // Broadcast
            channel.send({
                type: 'broadcast',
                event: 'ring',
                payload: { timestamp: new Date() },
            });

            setTimeout(() => rope.classList.remove('rope-pulled'), 200);
        });
        
        // Touch
        trigger.addEventListener('touchstart', (e) => {
             e.preventDefault();
             rope.classList.add('rope-pulled');
             playBell();
             channel.send({ type: 'broadcast', event: 'ring', payload: {} });
             setTimeout(() => rope.classList.remove('rope-pulled'), 200);
        });

    </script>
</body>
</html>
