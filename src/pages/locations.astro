---
import Layout from '@layouts/Layout.astro';
import { supabase } from '@lib/supabaseClient';

// Fetch churches at BUILD TIME so the list + mass times are crawlable (SEO).
// Resilient: if the build host can't reach Supabase, fall back to an empty
// list and let the client script fetch at runtime (current behaviour).
let churches: any[] = [];
try {
    const { data } = await supabase.from('churches').select('*');
    churches = (data ?? []).filter((c) => c && c.name);
} catch {
    churches = [];
}

function massTimesText(mt: any): string {
    if (!mt) return '';
    let t = mt;
    if (typeof mt === 'string') {
        try {
            t = JSON.parse(mt);
        } catch {
            return mt;
        }
    }
    const parts: string[] = [];
    if (t?.sunday) parts.push(`Søndag: ${t.sunday}`);
    if (t?.weekdays) parts.push(`Hverdage: ${t.weekdays}`);
    return parts.join(' · ');
}

const churchLd = churches.map((c) => ({
    '@type': 'CatholicChurch',
    name: c.name,
    ...(c.address ? { address: c.address } : {}),
    ...(c.website ? { url: c.website } : {}),
    ...(c.latitude && c.longitude
        ? { geo: { '@type': 'GeoCoordinates', latitude: c.latitude, longitude: c.longitude } }
        : {}),
}));

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebPage',
            name: 'Kirkekortet — katolske kirker og messetider i Danmark',
            description:
                'Interaktivt kort over katolske kirker i Danmark. Find nærmeste menighed og søndagens messe.',
            url: 'https://oratorium.dk/locations',
            inLanguage: 'da-DK',
            about: { '@type': 'Thing', name: 'Katolske kirker i Danmark' },
        },
        ...churchLd,
    ],
};
---

<Layout
    title="Kirkekortet | Oratorium"
    description="Kirkekortet — find katolske kirker og messetider i Danmark. Find vej til nærmeste menighed og søndagens messe."
    bodyClass="selection:bg-gold-500/30 min-h-screen flex flex-col pt-32"
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)}></script>

<style is:global>
body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }

        #map { height: 80vh; width: 100%; z-index: 10; border-top: 1px solid rgba(255, 215, 0, 0.2); border-bottom: 1px solid rgba(255, 215, 0, 0.2); }

        /* Custom Popup Styling */
        .leaflet-popup-content-wrapper, .leaflet-popup-tip {
            background: #1a1a20 !important;
            color: #e5e7eb !important;
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 0 15px rgba(0,0,0,0.5);
        }
        .leaflet-popup-close-button {
            color: #9ca3af !important;
        }

        /* Typography inside Popup */
        .leaflet-popup-content h3 { color: #fde047 !important; /* Gold-300 */ }
        .leaflet-popup-content p { color: #d1d5db !important; /* Gray-300 */ }
        .leaflet-popup-content a { color: #eab308 !important; /* Gold-500 */ }

        /* Marker Icon */
        .custom-icon {
            text-align: center;
            line-height: 1;
        }
</style>
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <!-- Header -->
    <header class="text-center mb-8 px-4">
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-2 font-serif drop-shadow-lg">Kirkekortet</h1>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans">Find en Messe nær dig</p>
    </header>

    <!-- Map Container -->
    <div id="map"></div>

    <div class="text-center py-8 text-xs text-gray-600 uppercase tracking-widest">
        Viser katolske kirker i Danmark
    </div>

    {churches.length > 0 && (
        <section class="max-w-4xl mx-auto px-6 pb-24 w-full sans" aria-label="Liste over kirker">
            <h2 class="text-2xl text-gold-300 font-serif mb-8 text-center">Katolske kirker i Danmark</h2>
            <ul class="space-y-6 list-none">
                {churches.map((c) => (
                    <li class="border border-white/10 rounded-lg p-6 bg-white/[0.02]">
                        <h3 class="text-lg text-gold-200 font-serif">{c.name}</h3>
                        {c.address && <p class="text-sm text-gray-400 italic mt-1">{c.address}</p>}
                        {c.description && (
                            <p class="text-sm text-gray-400 mt-2 leading-relaxed">{c.description}</p>
                        )}
                        {massTimesText(c.mass_times) && (
                            <p class="text-sm text-gray-300 mt-3">
                                <span class="text-gold-500">Messetider:</span> {massTimesText(c.mass_times)}
                            </p>
                        )}
                        {c.website && (
                            <a
                                href={c.website}
                                class="inline-block mt-3 text-xs uppercase tracking-widest text-gold-500 hover:text-white transition-colors"
                            >
                                Besøg hjemmeside →
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        </section>
    )}

    {churches.length > 0 && (
        <script type="application/json" id="churches-data" set:html={JSON.stringify(churches)} />
    )}

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script type="module">
        import { supabase } from '@lib/supabaseClient';

        // Initialize Map (Centered on Denmark)
        const map = L.map('map').setView([56.2639, 9.5018], 7);

        // Dark Matter Tiles
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);

        // Prefer churches embedded at build time; otherwise fetch at runtime.
        async function getChurches() {
            const el = document.getElementById('churches-data');
            if (el && el.textContent) {
                try { return JSON.parse(el.textContent); } catch (e) { /* fall through */ }
            }
            try {
                const { data, error } = await supabase.from('churches').select('*');
                if (error) { console.error('Error loading churches:', error); return []; }
                return data || [];
            } catch (e) {
                console.error('Error loading churches:', e);
                return [];
            }
        }

        function renderChurches(churches) {
            churches.forEach(c => {
                const lat = c.latitude;
                const lng = c.longitude;
                if (lat == null || lng == null) return;

                const icon = L.divIcon({
                    className: 'custom-icon',
                    html: `<i class="fa-solid fa-cross text-gold-500 text-3xl drop-shadow-[0_0_10px_rgba(255,215,0,0.8)]"></i>`,
                    iconSize: [30, 30],
                    iconAnchor: [15, 30],
                    popupAnchor: [0, -30]
                });

                let massHtml = '';
                if(c.mass_times) {
                     const times = typeof c.mass_times === 'string' ? JSON.parse(c.mass_times) : c.mass_times;
                     massHtml += `<div class="mt-3 border-t border-gray-700 pt-2 text-xs">`;
                     if(times.sunday) massHtml += `<div class="flex justify-between"><span class="text-gold-500">Søndag:</span> <span>${times.sunday}</span></div>`;
                     if(times.weekdays) massHtml += `<div class="flex justify-between"><span class="text-gray-400">Hverdage:</span> <span>${times.weekdays}</span></div>`;
                     massHtml += `</div>`;
                }

                const popupContent = `
                    <h3 class="font-serif text-gold-200 text-lg mb-1 border-b border-gold-500/30 pb-1">${c.name}</h3>
                    <p class="text-xs text-gray-400 italic mb-2">${c.address || ''}</p>
                    ${c.description ? `<p class="text-gray-300 text-xs leading-relaxed mb-2">${c.description}</p>` : ''}
                    ${massHtml}
                    ${c.website ? `<a href="${c.website}" target="_blank" class="block mt-3 text-gold-500 text-xs uppercase hover:text-white transition-colors">Besøg Hjemmeside &rarr;</a>` : ''}
                `;

                L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup(popupContent);
            });
        }

        getChurches().then(renderChurches);
    </script>
</Layout>
