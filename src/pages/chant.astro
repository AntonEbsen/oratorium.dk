---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Lytterummet | Oratorium"
    description="Lytterummet — gregoriansk sang og hellig musik (Musica Sacra). Lad stilheden og sangen løfte sjælen mod Gud."
    extraFonts={["Playfair+Display:ital@0;1"]}
    bodyClass="selection:bg-gold-500/30 h-screen w-screen flex flex-col items-center justify-center relative"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #010101; color: #e5e7eb; overflow: hidden; }
        .sans { font-family: 'Inter', sans-serif; }
        
        .pulse-ring {
            animation: pulse-ring 4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.5; }
            100% { transform: scale(2); opacity: 0; }
        }

        .visualizer-bar {
            transition: height 0.1s ease;
            background: linear-gradient(to top, #333, #666);
        }
        .playing .visualizer-bar {
             background: linear-gradient(to top, #D4AF37, #FFF);
             box-shadow: 0 0 10px #D4AF37;
        }
</style>
    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/seek" class="text-white/30 hover:text-gold-500 transition-colors text-xl flex items-center gap-2 sans bg-black/50 p-2 rounded backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Forlad Stilheden</span>
        </a>
    </nav>
    
    <!-- Background -->
    <div class="absolute inset-0 z-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-b from-black via-[#050505] to-[#101010]"></div>

    <!-- MAIN PLAYER -->
    <main class="relative z-10 text-center max-w-2xl w-full px-6">
        
        <div class="mb-12 relative inline-block">
             <div class="absolute inset-0 border border-gold-500/20 rounded-full pulse-ring"></div>
             <div class="w-48 h-48 rounded-full bg-[#0a0a0a] border border-gold-500/30 flex items-center justify-center shadow-[0_0_50px_rgba(212,175,55,0.1)] relative overflow-hidden group">
                 <!-- Album Art / Icon -->
                 <i class="fa-solid fa-music text-4xl text-gold-500/50 group-hover:text-gold-500 transition-colors" id="play-icon"></i>
                 
                 <!-- Play Overlay -->
                 <button id="main-play-btn" class="absolute inset-0 z-20 flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                     <i class="fa-solid fa-play text-3xl text-white"></i>
                 </button>
             </div>
        </div>

        <h1 class="text-3xl md:text-5xl text-gold-500 mb-4 font-serif drop-shadow-lg tracking-widest" id="track-title">Salve Regina</h1>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans mb-12">Det Gregorianske Kapel</p>

        <!-- Visualizer (Fake) -->
        <div class="flex justify-center items-end gap-1 h-12 mb-12" id="visualizer">
            <!-- Bars generated by JS -->
        </div>

        <!-- Controls -->
        <div class="flex justify-center gap-8 items-center">
            <button class="text-gray-600 hover:text-white transition-colors"><i class="fa-solid fa-backward-step text-xl"></i></button>
            
            <button id="play-pause-btn" class="w-16 h-16 bg-gold-900/20 border border-gold-500 rounded-full flex items-center justify-center text-gold-500 text-2xl hover:bg-gold-500 hover:text-black transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(212,175,55,0.2)]">
                <i class="fa-solid fa-play ml-1"></i>
            </button>
            
            <button class="text-gray-600 hover:text-white transition-colors"><i class="fa-solid fa-forward-step text-xl"></i></button>
        </div>

        <!-- Playlist -->
        <div class="mt-16 text-left max-w-sm mx-auto border-t border-white/5 pt-8">
            <p class="text-[10px] text-gray-600 uppercase tracking-widest mb-4 text-center">Spilleliste</p>
            <ul class="space-y-4">
                <li class="flex justify-between items-center text-sm text-gold-500 cursor-pointer hover:bg-white/5 p-2 rounded">
                    <span>1. Salve Regina</span>
                    <span class="text-xs opacity-50">03:12</span>
                </li>
                <li class="flex justify-between items-center text-sm text-gray-500 cursor-pointer hover:text-white hover:bg-white/5 p-2 rounded transition-colors">
                    <span>2. Kyrie Eleison</span>
                    <span class="text-xs opacity-50">02:45</span>
                </li>
                <li class="flex justify-between items-center text-sm text-gray-500 cursor-pointer hover:text-white hover:bg-white/5 p-2 rounded transition-colors">
                    <span>3. Pange Lingua</span>
                    <span class="text-xs opacity-50">04:20</span>
                </li>
                 <li class="flex justify-between items-center text-sm text-gray-500 cursor-pointer hover:text-white hover:bg-white/5 p-2 rounded transition-colors">
                    <span>4. Stilhed</span>
                    <span class="text-xs opacity-50">∞</span>
                </li>
            </ul>
        </div>

    </main>

    <!-- Audio Element -->
    <audio id="audio-player" loop>
        <source src="/assets/audio/chant.mp3" type="audio/mpeg"> <!-- Reusing existing asset -->
    </audio>

    <script>
        const audio = document.getElementById('audio-player') as HTMLAudioElement;
        const playBtn = document.getElementById('play-pause-btn');
        const mainPlayBtn = document.getElementById('main-play-btn');
        const icon = playBtn?.querySelector('i');
        const mainIcon = mainPlayBtn?.querySelector('i');
        const visualizer = document.getElementById('visualizer');
        const container = document.querySelector('.pulse-ring');

        // Generate Visualizer Bars
        for(let i=0; i<20; i++) {
            const bar = document.createElement('div');
            bar.className = 'visualizer-bar w-1 md:w-2 bg-gray-800 rounded-t';
            bar.style.height = '20%';
            visualizer?.appendChild(bar);
        }

        let isPlaying = false;
        let animationId;

        function togglePlay() {
            if(audio.paused) {
                audio.play();
                isPlaying = true;
                icon?.classList.remove('fa-play');
                icon?.classList.add('fa-pause');
                
                mainIcon?.classList.remove('fa-play');
                mainIcon?.classList.add('fa-pause');

                container?.classList.remove('hidden');
                animateVisualizer();
            } else {
                audio.pause();
                isPlaying = false;
                icon?.classList.remove('fa-pause');
                icon?.classList.add('fa-play');
                
                mainIcon?.classList.remove('fa-pause');
                mainIcon?.classList.add('fa-play');
                
                cancelAnimationFrame(animationId);
                resetVisualizer();
            }
        }

        playBtn?.addEventListener('click', togglePlay);
        mainPlayBtn?.addEventListener('click', togglePlay);

        function animateVisualizer() {
            if(!isPlaying) return;
            
            const bars = document.querySelectorAll('.visualizer-bar');
            bars.forEach(bar => {
                // Fake frequency data
                const h = Math.random() * 80 + 20;
                (bar as HTMLElement).style.height = `${h}%`;
                bar.classList.add('playing');
            });

            animationId = requestAnimationFrame(() => {
                // slow down update
                setTimeout(animateVisualizer, 100);
            });
        }

        function resetVisualizer() {
             const bars = document.querySelectorAll('.visualizer-bar');
             bars.forEach(bar => {
                 (bar as HTMLElement).style.height = '20%';
                 bar.classList.remove('playing');
             });
        }

    </script>
</Layout>
