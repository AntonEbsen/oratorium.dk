---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Forbøn | Ad Majorem Dei Gloriam"
    noindex
    bodyClass="selection:bg-gold-500/30 min-h-screen flex flex-col"
>

<style is:global>
body { font-family: 'Cinzel', serif; background: #050508; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
        
        .prayer-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }
        .prayer-card:hover {
            border-color: rgba(255, 215, 0, 0.2);
            background: rgba(255, 215, 0, 0.02);
            transform: translateY(-2px);
        }
        
        .pray-btn:hover i {
            animation: pulse-gold 1s infinite;
        }
        
        @keyframes pulse-gold {
            0% { transform: scale(1); text-shadow: 0 0 0 rgba(255,215,0,0); }
            50% { transform: scale(1.2); text-shadow: 0 0 10px rgba(255,215,0,0.8); }
            100% { transform: scale(1); text-shadow: 0 0 0 rgba(255,215,0,0); }
        }
        
        /* Floating particles effect for successful prayer */
        @keyframes float-up {
            0% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-50px); }
        }
        .prayer-particle {
            position: absolute;
            color: #FFD700;
            pointer-events: none;
            animation: float-up 1s ease-out forwards;
            font-size: 10px;
        }
</style>
    <!-- Background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
         <div class="absolute inset-0 opacity-10" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png');"></div>
         <div class="absolute bottom-0 w-full h-[30vh] bg-gradient-to-t from-gold-900/10 to-transparent"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>
    
    <!-- Header -->
     <header class="text-center pt-24 pb-12 relative z-10">
        <h1 class="text-4xl md:text-5xl text-transparent bg-clip-text bg-gradient-to-b from-gold-200 to-gold-600 mb-4 drop-shadow-lg">
            Forbøn
        </h1>
        <p class="text-xs sans text-gray-500 uppercase tracking-[0.3em]">
            Bær hinandens byrder
        </p>
    </header>

    <!-- Main Content -->
    <main class="relative z-10 w-full max-w-4xl mx-auto px-6 pb-20 grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- LEFT: SUBMISSION FORM -->
        <section class="lg:col-span-1">
            <div class="sticky top-32">
                <div class="bg-gray-900/30 border border-gold-900/30 p-8 rounded-lg backdrop-blur-sm relative group hover:border-gold-500/30 transition-colors">
                    <div class="absolute -top-3 -left-3 text-gold-500 text-2xl opacity-50"><i class="fa-solid fa-quote-left"></i></div>
                    
                    <h2 class="text-sm text-gold-400 mb-6 font-bold uppercase tracking-widest flex items-center gap-2">
                        <i class="fa-solid fa-pen-nib"></i> Nyt Emne
                    </h2>

                    <form id="prayer-form" class="space-y-6">
                        <div>
                            <textarea 
                                id="inp-content"
                                required 
                                maxlength="300"
                                rows="5"
                                class="w-full bg-black/40 border border-gray-800 rounded p-4 text-gray-300 sans text-sm focus:border-gold-500/50 outline-none transition-colors placeholder:text-gray-700 resize-none leading-relaxed"
                                placeholder="Hvad skal vi bede for?"
                            ></textarea>
                        </div>
                        
                        <div class="flex flex-col gap-4">
                            <input 
                                type="text" 
                                id="inp-author"
                                class="bg-transparent border-b border-gray-800 text-gray-500 text-xs sans uppercase tracking-widest focus:border-gold-500/50 outline-none py-2"
                                placeholder="Navn (eller Anonym)"
                            >
                            
                            <button type="submit" class="bg-gold-900/20 hover:bg-gold-500/20 text-gold-500 border border-gold-500/30 w-full py-3 rounded text-xs sans uppercase tracking-widest transition-all hover:shadow-[0_0_15px_rgba(255,215,0,0.1)]">
                                Send Bøn
                            </button>
                        </div>
                    </form>
                    
                    <!-- Success Overlay -->
                    <div id="success-msg" class="absolute inset-0 bg-[#050508]/95 flex flex-col items-center justify-center rounded-lg opacity-0 pointer-events-none transition-opacity border border-gold-500/20">
                        <i class="fa-solid fa-check text-gold-500 text-3xl mb-4 animate-bounce"></i>
                        <p class="text-gold-200 sans text-xs uppercase tracking-widest">Bøn Modtaget</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT: PRAYER WALL -->
        <section class="lg:col-span-2">
             <div class="flex items-center justify-between mb-8 border-b border-white/5 pb-4">
                <span class="text-xs sans uppercase tracking-widest text-gray-500">Bønner fra Fællesskabet</span>
                <span class="text-xs sans text-gray-700" id="total-count">...</span>
             </div>

             <!-- Grid Container -->
             <div id="prayer-feed" class="space-y-4">
                 <!-- Loading State -->
                 <div class="animate-pulse bg-gray-900/20 h-32 rounded border border-white/5"></div>
                 <div class="animate-pulse bg-gray-900/20 h-32 rounded border border-white/5"></div>
             </div>
        </section>

    </main>

    <script>
        import { checkAndAwardStamp } from '../utils/stamps';

        // CLIENT CONFIG
        
import { supabase } from '@lib/supabaseClient';
        
        const feed = document.getElementById('prayer-feed');
        const form = document.getElementById('prayer-form');
        const successMsg = document.getElementById('success-msg');
        const totalCount = document.getElementById('total-count');

        // Fetch
        async function fetchPrayers() {
            const { data, error } = await supabase
                .from('prayers')
                .select('*')
                .eq('approved', true) // Only approved
                .order('created_at', { ascending: false });

            if(error) {
                console.error(error);
                feed.innerHTML = `<p class="text-gray-600 text-sm italic">Kunne ikke hente bønner.</p>`;
                return;
            }
            
            renderPrayers(data);
        }

        function renderPrayers(prayers) {
            feed.innerHTML = '';
            
            if(!prayers || prayers.length === 0) {
                feed.innerHTML = `<p class="text-gray-600 text-sm italic py-10 text-center">Ingen bønner endnu.</p>`;
                return;
            }
            
            totalCount.innerText = prayers.length + " Bønner";

            prayers.forEach(prayer => {
                const date = new Date(prayer.created_at).toLocaleDateString('da-DK', { day: 'numeric', month: 'short' });
                const count = prayer.prayer_count || 0;
                // Add default author logic if blank in DB
                const author = prayer.author || "Anonym"; 
                // DB might not have 'author' col if I didn't add it in update script? 
                // Wait, my update script added 'content', 'prayer_count'. 
                // It didn't explicitly add 'author'. 
                // The old schema MIGHT have it. If not, this is safer:
                // I will assume it's there or handle undefined.
                
                const authorName = escapeHtml(author);
                let authorHtml = `<span>${authorName}</span>`;
                
                if(prayer.user_id) {
                    authorHtml = `<a href="/pilgrim?id=${prayer.user_id}" class="hover:text-gold-500 hover:underline transition-colors">${authorName}</a>`;
                }

                const el = document.createElement('div');
                el.className = "prayer-card p-6 rounded relative overflow-hidden group";
                el.innerHTML = `
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-grow">
                             <p class="text-gray-300 font-serif leading-relaxed text-lg mb-3">
                                "${escapeHtml(prayer.content)}"
                             </p>
                             <div class="flex gap-3 text-[10px] sans uppercase tracking-widest text-gray-600">
                                ${authorHtml}
                                <span>•</span>
                                <span>${date}</span>
                             </div>
                        </div>
                        
                        <!-- INTERCESSION BUTTON -->
                        <button onclick="prayFor('${prayer.id}', ${count}, this)" class="pray-btn flex flex-col items-center gap-1 text-gold-500/40 hover:text-gold-500 transition-colors group-hover:scale-105 duration-300">
                             <i class="fa-solid fa-hands-praying text-2xl mb-1 transition-transform"></i>
                             <span class="text-[9px] font-mono prayer-count">${count}</span>
                             <span class="text-[8px] opacity-0 group-hover:opacity-100 transition-opacity absolute -bottom-4 whitespace-nowrap">BED FOR</span>
                        </button>
                    </div>
                `;
                feed.appendChild(el);
            });
        }

        // Global function for onclick
        window.prayFor = async (id, currentCount, btn) => {
            // Check auth
            const { data: { session } } = await supabase.auth.getSession();
            if(!session) {
                alert("Log ind for at bede med.");
                return;
            }
            const userId = session.user.id;

            // Optimistic Update
            const countLabel = btn.querySelector('.prayer-count');
            const newCount = currentCount + 1;
            countLabel.innerText = newCount;
            btn.classList.add('text-gold-500'); // persist color
            btn.onclick = null; // Prevent double click spamming easily

            // Particle FX
            const rect = btn.getBoundingClientRect();
            const part = document.createElement('div');
            part.className = 'prayer-particle';
            part.innerText = '+1 Bøn';
            part.style.left = (rect.left + 10) + 'px';
            part.style.top = (rect.top) + 'px';
            document.body.appendChild(part);
            setTimeout(() => part.remove(), 1000);

            // DB Update 1: Increment Count on Prayer
            await supabase
                .from('prayers')
                .update({ prayer_count: newCount })
                .eq('id', id);
            
            // DB Update 2: Record Interaction
            await supabase
                .from('prayer_interactions')
                .insert([{ user_id: userId, prayer_id: id }])
                .then(async ({ error }) => {
                     if(error && error.code !== '23505') { // Ignore unique violation (already prayed)
                         console.error("Interaction error", error);
                     } else {
                         // Check for Stamps (Fire and Forget)
                         // 1. Prayer Warrior 1 (Forbeder I) - Just need 1 interaction
                         checkAndAwardStamp(supabase, userId, 'prayer_warrior_1').then(res => {
                             if(res.awarded) alert("Tillykke! Du har opnået stemplet: Forbeder I");
                         });

                         // 2. Prayer Warrior 10 (Forbeder II)
                         // Check count
                         const { count } = await supabase
                            .from('prayer_interactions')
                            .select('*', { count: 'exact', head: true })
                            .eq('user_id', userId);
                        
                         if(count && count >= 10) {
                             checkAndAwardStamp(supabase, userId, 'prayer_warrior_10').then(res => {
                                 if(res.awarded) alert("Tillykke! Du har opnået stemplet: Forbeder II");
                             });
                         }
                     }
                });
        };

        // Submit
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const content = document.getElementById('inp-content').value;
            const authorVal = document.getElementById('inp-author').value;
            
            // Get Current User
            const { data: { session } } = await supabase.auth.getSession();
            const userId = session?.user?.id || null;

            const payload = { 
                content: content,
                prayer_count: 0,
                approved: true,
                user_id: userId // Link to profile
            };
            if(authorVal) (payload as any).author = authorVal; 
            
            const { error } = await supabase.from('prayers').insert([payload]);

            if(error) {
                console.error(error);
                // Fallback: maybe 'author' column missing?
                if(error.message.includes('author')) {
                     delete (payload as any).author; // remove and retry
                     await supabase.from('prayers').insert([payload]);
                } else {
                     alert("Fejl: " + error.message);
                     return;
                }
            } 
            
            // Success
            successMsg.style.opacity = '1';
            form.reset();
            fetchPrayers();
            
            setTimeout(() => {
                successMsg.style.opacity = '0';
            }, 2000);
        });

        function escapeHtml(text) {
             if(!text) return "";
             return text.replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        fetchPrayers();
    </script>
</Layout>
