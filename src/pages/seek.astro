    <script>

import { supabase as client } from '@lib/supabaseClient';

        const progressBar = document.getElementById('progress-bar-container');
        const progressFill = document.getElementById('progress-fill');
        const progressText = document.getElementById('progress-text');
        const checkboxes = document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        
        let currentUser: any = null;

        async function init() {
            const { data: { session } } = await client.auth.getSession();
            
            if(session) {
                currentUser = session.user;
                progressBar?.classList.remove('-translate-y-full'); // Show progress bar
                loadProgress();
            } else {
                // Optional: Show "Log in to track progress" message?
                // For now, checkboxes remain interactive but warn on click? 
                // Or let's disable them visually or make them redirect to login.
                checkboxes.forEach((cb) => {
                    cb.addEventListener('click', (e) => {
                        e.preventDefault();
                        if(confirm("Log ind for at gemme din rejse.")) {
                            window.location.href = '/login';
                        }
                    });
                });
            }
        }

        async function loadProgress() {
            // Get all user checks
            const { data: checks } = await client
                .from('user_checklist')
                .select('item_id')
                .eq('user_id', currentUser.id);
            
            const checkedIds = checks ? checks.map(c => c.item_id) : [];

            // Update UI
            let total = checkboxes.length;
            let count = 0;

            checkboxes.forEach((cb) => {
                const id = cb.dataset.id;
                if(checkedIds.includes(id)) {
                    cb.checked = true;
                    count++;
                }
                
                // Add Listener
                cb.addEventListener('change', async (e) => {
                    if(cb.checked) {
                        // Insert
                        await client.from('user_checklist').insert([{ user_id: currentUser.id, item_id: id }]);
                    } else {
                        // Delete
                        await client.from('user_checklist').delete().eq('user_id', currentUser.id).eq('item_id', id);
                    }
                    updateBar();
                });
            });

            updateBar();

            function updateBar() {
                 let checkedCount = document.querySelectorAll('input[type="checkbox"]:checked').length;
                 let pct = Math.round((checkedCount / total) * 100);
                 if(progressFill) progressFill.style.width = `${pct}%`;
                 if(progressText) progressText.innerText = `${pct}%`;
            }
        }

        init();
    </script>
