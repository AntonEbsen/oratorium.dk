
---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Vejen Hjem | Oratorium"
    description="For dig, der søger sandheden, skønheden og det evige. En guide til vejen ind i Den Katolske Kirke — fra de første spørgsmål til optagelse."
    bodyClass="min-h-screen flex flex-col pt-32"
>
    <style>
        /* Timeline Line */
        .timeline-line::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 1px;
            background: linear-gradient(to bottom, transparent, #ffd700, transparent);
            transform: translateX(-50%);
            z-index: 0;
        }
    </style>

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage til Helligdommen</span>
        </a>
    </nav>

    <!-- PROGRESS BAR (Sticky) -->
    <div class="fixed top-0 left-0 w-full z-40 bg-[#020205]/90 backdrop-blur border-b border-white/5 py-4 px-8 flex items-center justify-between transition-transform duration-500 -translate-y-full" id="progress-bar-container">
        <div class="text-xs text-gold-500 uppercase tracking-widest">Min Rejse</div>
        <div class="flex-grow mx-8 bg-gray-800 h-1 rounded-full overflow-hidden">
            <div id="progress-fill" class="bg-gold-500 h-full w-0 transition-all duration-1000"></div>
        </div>
        <div id="progress-text" class="text-xs text-gray-400 font-mono">0%</div>
    </div>

    <!-- Hero -->
    <header class="text-center mb-24 px-4 relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-gold-500/10 rounded-full blur-[100px] pointer-events-none"></div>
        <h1 class="text-5xl md:text-7xl text-gold-500 mb-6 font-serif drop-shadow-[0_0_15px_rgba(255,215,0,0.3)]">Vejen Hjem</h1>
        <p class="text-lg text-gray-400 italic font-serif mb-8">"Kom og se." — Johannes 1,39</p>
        <p class="text-xs text-gray-500 uppercase tracking-[0.3em] sans max-w-lg mx-auto leading-loose">
            For dig, der søger sandheden, skønheden og det evige. Velkommen til porten mod den Katolske Kirke.
        </p>
    </header>

    <!-- Introduction / Call to Action -->
    <div class="max-w-4xl mx-auto px-6 text-center mb-32">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-left">
            <div class="bg-white/5 border border-white/10 p-8 rounded hover:border-gold-500/30 transition-colors group">
                <i class="fa-solid fa-question text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block"></i>
                <h3 class="text-xl text-gold-200 mb-4 font-serif">Har du spørgsmål?</h3>
                <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                    Er du nysgerrig på paven, Jomfru Maria eller Sakramenterne? Tal med Thomas Aquinas, vores teologiske guide.
                </p>
                <a href="/aquinas" class="text-gold-500 text-xs uppercase tracking-widest hover:text-white border-b border-gold-500/30 pb-1">Spørg Aquinas <i class="fa-solid fa-arrow-right ml-2"></i></a>
            </div>

             <div class="bg-white/5 border border-white/10 p-8 rounded hover:border-gold-500/30 transition-colors group">
                <i class="fa-solid fa-users text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block"></i>
                <h3 class="text-xl text-gold-200 mb-4 font-serif">Mød Konvertitter</h3>
                <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                    Læs vidnesbyrd fra andre danskere, der har fundet deres vej hjem til Kirken. Du er ikke alene på rejsen.
                </p>
                <a href="/testimony" class="text-gold-500 text-xs uppercase tracking-widest hover:text-white border-b border-gold-500/30 pb-1">Læs Historier <i class="fa-solid fa-arrow-right ml-2"></i></a>
            </div>
        </div>
    </div>

    <!-- The Roadmap (Timeline) -->
    <div class="max-w-3xl mx-auto px-6 relative timeline-line mb-32">
        <h2 class="text-3xl text-center text-gold-500 mb-16 font-serif bg-[#020205] relative z-10 px-4 inline-block mx-auto left-1/2 -translate-x-1/2">
            Rejsen mod Troen
        </h2>

        <!-- Step 1 -->
        <div class="relative z-10 mb-24 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="text-right md:text-right order-2 md:order-1">
                <h3 class="text-xl text-gold-200 font-serif">1. Undersøgelsesfasen</h3>
                <p class="text-xs text-gold-500 uppercase tracking-widest mb-4">Prækatekumentatet</p>
                <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                    Dette er tiden til at stille spørgsmål. Ingen forpligtelser. Du udforsker troen, går til messe og taler med en præst.
                </p>
                
                <!-- CHECKLIST ITEMS -->
                <div class="flex flex-col items-end gap-2">
                    <label class="seeker-item cursor-pointer group flex items-center gap-3 justify-end opacity-70 hover:opacity-100 transition-opacity">
                        <span class="text-[10px] uppercase tracking-widest text-gray-400 group-hover:text-gold-200 transition-colors text-right">Deltag i en Messe</span>
                        <input type="checkbox" data-id="attend_mass" class="peer appearance-none w-4 h-4 border border-gold-500/50 rounded-sm checked:bg-gold-500 transition-colors relative cursor-pointer">
                        <i class="fa-solid fa-check text-black text-[10px] absolute right-[2px] opacity-0 peer-checked:opacity-100 pointer-events-none"></i>
                    </label>
                    <label class="seeker-item cursor-pointer group flex items-center gap-3 justify-end opacity-70 hover:opacity-100 transition-opacity">
                        <span class="text-[10px] uppercase tracking-widest text-gray-400 group-hover:text-gold-200 transition-colors text-right">Tal med en Præst</span>
                        <input type="checkbox" data-id="talk_priest" class="peer appearance-none w-4 h-4 border border-gold-500/50 rounded-sm checked:bg-gold-500 transition-colors relative cursor-pointer">
                        <i class="fa-solid fa-check text-black text-[10px] absolute right-[2px] opacity-0 peer-checked:opacity-100 pointer-events-none"></i>
                    </label>
                </div>

            </div>
            <div class="flex justify-center md:justify-start order-1 md:order-2">
                <div class="w-16 h-16 bg-[#020205] border border-gold-500 rounded-full flex items-center justify-center text-gold-500 text-2xl shadow-[0_0_15px_rgba(255,215,0,0.2)]">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="relative z-10 mb-24 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
             <div class="flex justify-center md:justify-end order-1">
                <div class="w-16 h-16 bg-[#020205] border border-gold-500 rounded-full flex items-center justify-center text-gold-500 text-2xl shadow-[0_0_15px_rgba(255,215,0,0.2)]">
                    <i class="fa-solid fa-book-bible"></i>
                </div>
            </div>
            <div class="text-left order-2">
                <h3 class="text-xl text-gold-200 font-serif">2. Katekumenatet</h3>
                <p class="text-xs text-gold-500 uppercase tracking-widest mb-4">Læretiden</p>
                <p class="text-gray-400 sans text-sm leading-relaxed mb-6">
                    Du beslutter dig for at lære mere struktureret. Du bliver officielt "katekumen" og begynder at lære om dogmerne, bønnen og livet som kristen.
                </p>

                <!-- CHECKLIST ITEMS -->
                <div class="flex flex-col items-start gap-2">
                    <label class="seeker-item cursor-pointer group flex items-center gap-3 opacity-70 hover:opacity-100 transition-opacity">
                         <div class="relative">
                            <input type="checkbox" data-id="read_gospel" class="peer appearance-none w-4 h-4 border border-gold-500/50 rounded-sm checked:bg-gold-500 transition-colors cursor-pointer">
                            <i class="fa-solid fa-check text-black text-[10px] absolute left-[3px] top-[3px] opacity-0 peer-checked:opacity-100 pointer-events-none"></i>
                         </div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-400 group-hover:text-gold-200 transition-colors">Læs et Evangelium</span>
                    </label>
                     <label class="seeker-item cursor-pointer group flex items-center gap-3 opacity-70 hover:opacity-100 transition-opacity">
                         <div class="relative">
                            <input type="checkbox" data-id="learn_rosary" class="peer appearance-none w-4 h-4 border border-gold-500/50 rounded-sm checked:bg-gold-500 transition-colors cursor-pointer">
                            <i class="fa-solid fa-check text-black text-[10px] absolute left-[3px] top-[3px] opacity-0 peer-checked:opacity-100 pointer-events-none"></i>
                         </div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-400 group-hover:text-gold-200 transition-colors">Lær Rosenkransen</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="relative z-10 mb-24 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="text-right md:text-right order-2 md:order-1">
                <h3 class="text-xl text-gold-200 font-serif">3. Renselse og Oplysning</h3>
                <p class="text-xs text-gold-500 uppercase tracking-widest mb-2">Fastetiden</p>
                <p class="text-gray-400 sans text-sm leading-relaxed">
                    I ugerne op til Påske forbereder du dig åndeligt gennem bøn og bod. Du bliver skrevet ind i "De Udvalgtes Bog".
                </p>
            </div>
            <div class="flex justify-center md:justify-start order-1 md:order-2">
                <div class="w-16 h-16 bg-[#020205] border border-gold-500 rounded-full flex items-center justify-center text-gold-500 text-2xl shadow-[0_0_15px_rgba(255,215,0,0.2)]">
                    <i class="fa-solid fa-hands-praying"></i>
                </div>
            </div>
        </div>

        <!-- Step 4 -->
            <div class="text-left order-2">
                <h3 class="text-xl text-white font-serif">4. Initiering</h3>
                <p class="text-xs text-gold-500 uppercase tracking-widest mb-2">Påskenat</p>
                <p class="text-gray-300 sans text-sm leading-relaxed">
                    Højdepunktet. Du modtager Dåb (hvis ikke døbt), Firmelse og din første Kommunion. Du er nu fuldgyldigt medlem af Kirken.
                </p>
            </div>
        </div>

    </div>

    <!-- Deepening Section -->
    <div class="max-w-7xl mx-auto px-6 mb-32">
        <h2 class="text-2xl text-gold-500 mb-8 font-serif text-center">Fordybelse & Værktøjer</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- 1. Apologetics -->
            <a href="/scutum" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-red-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-red-900/5 group-hover:bg-red-900/10 transition-colors"></div>
                <i class="fa-solid fa-shield-halved text-red-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Troens Skjold</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Apologetik</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Tvivl? Hårde spørgsmål? Læs svarene på de sværeste indvendinger (Videnskab, Historie, Moral).
                </p>
            </a>

            <!-- 2. Prayer School -->
            <a href="/school" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-blue-500/50 transition-all group relative overflow-hidden">
                 <div class="absolute inset-0 bg-blue-900/5 group-hover:bg-blue-900/10 transition-colors"></div>
                <i class="fa-solid fa-hands-praying text-blue-400 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Bønneskolen</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Lær at Bede</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Start her. Lær de grundlæggende bønner (Fadervor, Ave Maria) og find roen.
                </p>
            </a>

            <!-- 3. Sanctuary -->
            <a href="/sanctuary" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-purple-500/50 transition-all group relative overflow-hidden">
                 <div class="absolute inset-0 bg-purple-900/5 group-hover:bg-purple-900/10 transition-colors"></div>
                <i class="fa-solid fa-church text-purple-400 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Kirkerummet</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Det Hellige Rum</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Hvad er den røde lampe? Hvorfor knæler vi? Forstå arkitekturen og det hellige.
                </p>
            </a>
            
            <!-- 4. Saint Gallery -->
            <a href="/saints" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-gold-500/50 transition-all group relative overflow-hidden">
                 <div class="absolute inset-0 bg-gold-900/5 group-hover:bg-gold-900/10 transition-colors"></div>
                <i class="fa-solid fa-crown text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Helgengalleriet</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Find Din Helgen</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Mød dine åndelige brødre og søstre. Tag quizzen og find din skytshelgen.
                </p>
            </a>

            <!-- 5. Dictionary -->
            <a href="/dictionary" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-emerald-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-emerald-900/5 group-hover:bg-emerald-900/10 transition-colors"></div>
                <i class="fa-solid fa-spell-check text-emerald-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Katolsk Ordbog</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Forstå Sproget</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Hvad er "Eukaristi"? "Transubstantiation"? Slå kirkens svære ord op her.
                </p>
            </a>
            
            <!-- 6. Rhythm (Rule of Life) -->
            <a href="/rhythm" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-orange-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-orange-900/5 group-hover:bg-orange-900/10 transition-colors"></div>
                <i class="fa-solid fa-hourglass-half text-orange-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Døgnets Rytme</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Livsstilen</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Morgenbøn, Angelus, Aftenbøn. Sådan lever en katolik midt i en travl hverdag.
                </p>
            </a>

            <!-- 7. Caritas (Charity) -->
            <a href="/caritas" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-red-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-red-900/5 group-hover:bg-red-900/10 transition-colors"></div>
                <i class="fa-solid fa-heart text-red-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Caritas</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Barmhjertigheden</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    "Tro uden gerninger er død." Læs om de 14 barmhjertighedsgerninger og gør troen konkret.
                </p>
            </a>
            
            <!-- 8. Catechism (Guide) -->
            <a href="/catechism" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-blue-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-blue-900/5 group-hover:bg-blue-900/10 transition-colors"></div>
                 <i class="fa-solid fa-book-bible text-blue-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Katekismen</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Troens Fire Søjler</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Forstå hele den katolske tro gennem de 4 hovedsøjler: Credo, Liturgi, Moral og Bøn.
                </p>
            </a>

            <!-- 9. Pope (NEW) -->
             <a href="/pope" class="bg-[#fdfbf7] border border-white/10 p-8 rounded hover:border-gold-500 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-white/5 group-hover:bg-white/10 transition-colors"></div>
                <i class="fa-solid fa-key text-gold-600 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-gray-900 font-serif mb-2 relative z-10">Paven</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Petri Stol</p>
                <p class="text-gray-600 sans text-sm leading-relaxed relative z-10">
                    Hvem er Paven? Forstå klippen, nøglerne og den apostolske succession.
                </p>
            </a>

            <!-- 9. Chant (Audio) -->
             <a href="/chant" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-gold-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-gold-900/5 group-hover:bg-gold-900/10 transition-colors"></div>
                <i class="fa-solid fa-music text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Lytterummet</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Musica Sacra</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Gregoriansk sang og stilhed. Lad musikken løfte sjælen mod Gud.
                </p>
            </a>

            <!-- 10. Schola Latina (Language) -->
            <a href="/latina" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-gold-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-gold-900/5 group-hover:bg-gold-900/10 transition-colors"></div>
                <i class="fa-solid fa-language text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Schola Latina</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Kirkens Sprog</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Lær at bede Fadervor og Ave Maria på latin. Forstå ordenes dybde.
                </p>
            </a>

            <!-- 11. Monasterium (Game) -->
            <a href="/monasterium" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-gold-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-gold-900/5 group-hover:bg-gold-900/10 transition-colors"></div>
                <i class="fa-solid fa-chess-rook text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Monasterium</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Ora et Labora</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Byg dit eget kloster. Bed, arbejd og rejs en katedral til Guds ære.
                </p>
            </a>

            <!-- 10. Pilgrim (Locations) -->
            <a href="/pilgrim" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-green-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-green-900/5 group-hover:bg-green-900/10 transition-colors"></div>
                 <i class="fa-solid fa-map-location-dot text-green-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Pilgrimsrejser</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Helligdomme</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Find vej til Åsebakken, Øm Kloster og andre danske helligdomme.
                </p>
            </a>

            <!-- 11. Testimonies (Social Proof) -->
            <a href="/testimony" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-gold-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-gold-900/5 group-hover:bg-gold-900/10 transition-colors"></div>
                <i class="fa-solid fa-users text-gold-500 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Vidnesbyrd</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">De Troendes Røst</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Læs personlige beretninger om vejen til troen. Du er ikke alene.
                </p>
            </a>

            <!-- 12. Calendar (Time) -->
            <a href="/calendar" class="bg-[#101015] border border-white/10 p-8 rounded hover:border-purple-500/50 transition-all group relative overflow-hidden">
                <div class="absolute inset-0 bg-purple-900/5 group-hover:bg-purple-900/10 transition-colors"></div>
                <i class="fa-solid fa-calendar-days text-purple-400 text-3xl mb-4 group-hover:scale-110 transition-transform block relative z-10"></i>
                <h3 class="text-xl text-white font-serif mb-2 relative z-10">Kirkeåret</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4 relative z-10">Hellig Tid</p>
                <p class="text-gray-400 sans text-sm leading-relaxed relative z-10">
                    Hvilken helgen fejrer vi i dag? Hvorfor er farven lilla? Følg Kirkens puls.
                </p>
            </a>

        </div>
    </div>

    <!-- LITURGY & PRACTICE (Mass & Confession) -->
    <div class="max-w-7xl mx-auto px-6 pb-24 border-t border-white/5 pt-24">
        <div class="text-center mb-12">
            <h2 class="text-3xl text-white font-serif mb-4">Liturgi & Praksis</h2>
            <p class="text-xs text-gray-500 uppercase tracking-widest sans">Forstå Kirkens Hellige Handlinger</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Mass Guide -->
            <a href="/mass" class="group relative block bg-[#0a0a0c] border border-white/10 rounded-lg overflow-hidden h-64">
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/black-linen.png')] opacity-20"></div>
