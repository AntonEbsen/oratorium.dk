<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Min Profil | Pilgrimspas</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col items-center pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-2xl px-6 text-center">
        
        <!-- Avatar -->
        <div id="avatar-container" class="w-24 h-24 bg-gold-900/20 border border-gold-500/30 rounded-full mx-auto flex items-center justify-center text-gold-500 text-3xl mb-4 overflow-hidden relative group shadow-[0_0_15px_rgba(255,215,0,0.2)]">
            <!-- Default Catholic Icon -->
            <i id="default-icon" class="fa-solid fa-cross drop-shadow-[0_0_5px_rgba(255,215,0,0.8)]"></i>
            <!-- Img will be injected here if exists -->
        </div>

        <!-- Headers -->
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-2">Pilgrimspas</h1>
        <p id="user-email" class="text-xs text-gray-500 uppercase tracking-widest mb-16 sans">Indlæser...</p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-8 mb-16">
            <div class="p-8 bg-white/5 border border-white/10 rounded">
                <i class="fa-solid fa-fire text-gold-500 text-3xl mb-4"></i>
