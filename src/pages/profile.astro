    <script>
        import { createClient } from '@supabase/supabase-js';
        import { libraryBooks } from '../utils/library';

        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        const client = createClient(SUPABASE_URL, SUPABASE_KEY);
        
        const emailEl = document.getElementById('user-email');
        const joinEl = document.getElementById('join-date');
        const modal = document.getElementById('edit-modal');
        const editFname = document.getElementById('edit-fname');
        const editLname = document.getElementById('edit-lname');
        const saveBtn = document.getElementById('save-btn');
        
        // Examen Elements
        const examenLoading = document.getElementById('examen-loading');
        const examenInput = document.getElementById('examen-input');
        const examenDisplay = document.getElementById('examen-display');
        const saveExamenBtn = document.getElementById('save-examen');

        let currentUser = null;

        async function init() {
            const { data: { session } } = await client.auth.getSession();
            
            if (!session) {
                window.location.href = '/login';
                return;
            }
            
            currentUser = session.user;
            
            // Get Profile Data
            const { data: profile } = await client
                .from('profiles')
                .select('*')
                .eq('id', currentUser.id)
                .single();
            
            // Check for Novice Stamp
            checkAndAwardStamp(client, currentUser.id, 'pilgrim_init').then(res => {
                 if(res.awarded) {
                     // Maybe show a toaster?
                     console.log("Awarded Novice Stamp!");
                     loadStamps(); // Refresh UI
                 }
            });

            // Display Info
            // Priority: (First + Last) > Username > Email
            let displayName = currentUser.email;
            if (profile) {
                if (profile.first_name || profile.last_name) {
                    displayName = `${profile.first_name || ''} ${profile.last_name || ''}`.trim();
                } else if (profile.username) {
                    displayName = profile.username;
                }
                
                // Populate Inputs
                if(editFname) (editFname as HTMLInputElement).value = profile.first_name || '';
                if(editLname) (editLname as HTMLInputElement).value = profile.last_name || '';

                // Render Avatar
                if(profile.avatar_url) {
                    const ac = document.getElementById('avatar-container');
                    if(ac) {
                        ac.innerHTML = `<img src="${profile.avatar_url}" class="w-full h-full object-cover">`;
                        ac.classList.add('shadow-[0_0_20px_rgba(255,215,0,0.3)]');
                    }
                    const pa = document.getElementById('preview-avatar');
                    if(pa) pa.innerHTML = `<img src="${profile.avatar_url}" class="w-full h-full object-cover">`;
                }
            }

            emailEl.innerHTML = `${displayName} <button onclick="toggleEdit()" class="ml-2 text-gold-500/50 hover:text-gold-500"><i class="fa-solid fa-pen"></i></button>`;
            
            // Rosary Count
            const rosaryCountEl = document.getElementById('rosary-count');
            if(rosaryCountEl) rosaryCountEl.innerText = profile?.rosary_count || 0;

            // Confession Logic
            const confDateInp = document.getElementById('confession-date');
            const confDaysEl = document.getElementById('days-since-confession');
            
            if(profile?.last_confession) {
                (confDateInp as HTMLInputElement).value = profile.last_confession;
                updateConfessionText(profile.last_confession);
            } else {
                confDaysEl.innerText = "Dato ikke sat";
            }

            // Update Listener
            confDateInp.addEventListener('change', async (e) => {
                const newDate = (e.target as HTMLInputElement).value;
                if(newDate) {
                    await client.from('profiles').update({ last_confession: newDate }).eq('id', currentUser.id);
                    updateConfessionText(newDate);
                }
            });

            function updateConfessionText(dateStr) {
                const last = new Date(dateStr);
                const today = new Date();
                const diff = Math.floor((constTime(today) - constTime(last)) / (1000 * 60 * 60 * 24));
                
                // Helper to fix TS error on arithmetic
                function constTime(d) { return d.getTime(); }

                if(diff < 0) confDaysEl.innerText = "I fremtiden?";
                else if (diff === 0) confDaysEl.innerText = "I dag";
                else confDaysEl.innerText = `${diff} dage siden`;
            }

            // Date
            const dateStr = profile?.created_at || currentUser.created_at;
            if(dateStr) {
                const joined = new Date(dateStr).toLocaleDateString('da-DK', { year: 'numeric', month: 'long' });
                joinEl.innerText = joined;
            } else {
                joinEl.innerText = "Ukendt";
            }

            // Fetch My Prayers
            const { data: myPrayers } = await client
                .from('prayers')
                .select('*')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });
            
            const prayersContainer = document.getElementById('my-prayers');
            if(myPrayers && myPrayers.length > 0) {
                prayersContainer.innerHTML = '';
                myPrayers.forEach(p => {
                    const div = document.createElement('div');
                    div.className = "bg-gray-900/40 p-4 rounded border border-white/5 hover:border-gold-500/20 transition-colors";
                    div.innerHTML = `
                        <p class="text-gray-300 font-serif italic mb-3 text-sm">"${p.content}"</p>
                        <div class="flex items-center gap-2 text-xs text-gold-500">
                             <i class="fa-solid fa-hands-praying"></i> 
                             <span>${p.prayer_count} har bedt</span>
                        </div>
                    `;
                    prayersContainer.appendChild(div);
                });
            } else {
                prayersContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-2 italic">Du har ikke delt nogen bønner endnu.</p>';
            }

            // Streak & Join Date Logic
            const streakEl = document.querySelector('h3.text-xl.text-white'); // The first h3 is streak
            if(streakEl) {
                const s = profile?.prayer_streak || 0;
                streakEl.innerText = s + " Dage";
                // If streak > 0, make fire icon glow
                if(s > 0) {
                    const fireIcon = document.querySelector('.fa-fire');
                    fireIcon?.classList.add('text-orange-500', 'animate-pulse');
                    fireIcon?.classList.remove('text-gold-500');
                }
            }

            // Fetch Intercessions (Joined Query)
            const { data: intercessions } = await client
                .from('prayer_interactions')
                .select('prayer_id, prayers(content, author)')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });

            const intContainer = document.getElementById('my-intercessions');
            if(intercessions && intercessions.length > 0) {
                intContainer.innerHTML = '';
                intercessions.forEach(int => {
                    // Supabase join returns nested object or array depending on relation type,
                    // but here it is Many-to-One so 'prayers' is object usually? No, it's singular if FK properly set.
                    // Actually, TypeScript usually warns, but JS is loose. 
                    // Let's handle 'prayers' as object.
                    const p = int.prayers; 
                    if(p) { // Check if prayer still exists
                        const div = document.createElement('div');
                        div.className = "bg-white/5 p-4 rounded border border-white/5 opacity-80 hover:opacity-100 transition-opacity";
                        div.innerHTML = `
                            <p class="text-gray-400 font-serif italic mb-2 text-xs">"${p.content}"</p>
                            <p class="text-[9px] uppercase tracking-widest text-gold-500/60">- ${p.author || 'Anonym'}</p>
                        `;
                        intContainer.appendChild(div);
                    }
                });
            } else {
                 intContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-2 italic">Du har ikke bedt for nogen endnu. Besøg Forbønsmuren.</p>';
            }

            // Fetch Bookmarks
            const { data: bookmarks } = await client
                .from('bookmarks')
                .select('book_id')
                .eq('user_id', currentUser.id);

            const marksContainer = document.getElementById('my-bookmarks');
            if(bookmarks && bookmarks.length > 0) {
                marksContainer.innerHTML = '';
                bookmarks.forEach(bm => {
                    const book = libraryBooks.find(b => b.id === bm.book_id);
                    if(book) {
                         const div = document.createElement('div');
                         // Mini Book Card
                         div.className = `relative h-40 w-full rounded shadow-md overflow-hidden ${book.coverColor} group cursor-pointer`;
                         div.innerHTML = `
                             <div class="absolute inset-0 opacity-20 mix-blend-multiply bg-black"></div>
