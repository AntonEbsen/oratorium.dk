        <div id="my-intercessions" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left mb-16">
            <p class="text-gray-600 text-xs text-center w-full col-span-2">Indlæser forbønner...</p>
        </div>

        <!-- Sacraments -->
        <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Mine Sakramenter</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
            
            <!-- Spiritual Bouquet -->
