        async function loadStamps() {
            const container = document.getElementById('stamps-container');
            
            // 1. Fetch User Unlocks
            const { data: unlocks } = await client
                .from('user_stamps')
                .select('stamp_id')
                .eq('user_id', currentUser.id);
            
            const unlockedIds = unlocks ? unlocks.map(u => u.stamp_id) : [];

            container.innerHTML = '';

            STAMPS.forEach(stamp => {
                const isUnlocked = unlockedIds.includes(stamp.id);
                // Visual Logic
                const opacity = isUnlocked ? 'opacity-100' : 'opacity-30 grayscale filter';
                const border = isUnlocked ? `border-${stamp.color.split('-')[1]}-500/50` : 'border-white/10';
                const bg = isUnlocked ? 'bg-white/5' : 'bg-transparent';
                const iconColor = isUnlocked ? stamp.color : 'text-gray-500';

                const div = document.createElement('div');
                div.className = `p-4 rounded border ${border} ${bg} ${opacity} transition-all flex flex-col items-center text-center gap-2 group relative`;
                div.innerHTML = `
                    <div class="h-12 w-12 rounded-full border border-white/10 flex items-center justify-center bg-black/50 mb-2">
                        <i class="fa-solid ${stamp.icon} ${iconColor} text-xl"></i>
                    </div>
                    <h4 class="text-white text-xs font-serif font-bold uppercase tracking-widest">${stamp.title}</h4>
                    <p class="text-[10px] text-gray-500 sans leading-tight">${stamp.description}</p>
                    ${isUnlocked ? `
                        <div class="absolute top-2 right-2 text-gold-500 text-[10px]">
                            <i class="fa-solid fa-check"></i>
                        </div>
                    ` : ''}
                `;
                container.appendChild(div);
            });
        }

        async function loadInbox() {
            const { data: messages } = await client
                .from('messages')
                .select('*, profiles:sender_id(username, first_name, last_name)') // Join sender profile
                .eq('receiver_id', currentUser.id)
                .order('created_at', { ascending: false });

            const inboxSec = document.getElementById('inbox-section');
            const inboxCont = document.getElementById('inbox-container');
            const cntEl = document.getElementById('msg-count');

            if(messages && messages.length > 0) {
                inboxSec.classList.remove('hidden');
                
                // Count unread
                const unread = messages.filter(m => !m.read).length;
                if(unread > 0) {
                    cntEl.innerText = unread;
                    cntEl.classList.remove('opacity-0');
                } else {
                    cntEl.classList.add('opacity-0');
                }

                inboxCont.innerHTML = '';
                
                messages.forEach(msg => {
                    const sender = msg.profiles;
                    let senderName = "Ukendt Pilgrim";
                    if(sender) {
                        if(sender.first_name || sender.last_name) senderName = `${sender.first_name||''} ${sender.last_name||''}`;
                        else if(sender.username) senderName = sender.username;
                    }

                    const date = new Date(msg.created_at).toLocaleDateString('da-DK');
                    const isNew = !msg.read;
                    
                    const div = document.createElement('div');
                    div.className = `p-4 rounded border text-left cursor-pointer transition-colors relative ${isNew ? 'bg-white/10 border-gold-500/50' : 'bg-white/5 border-white/5 hover:border-white/20'}`;
                    div.innerHTML = `
                        <div class="flex justify-between items-start mb-2">
                             <a href="/pilgrim?id=${msg.sender_id}" class="text-gold-500 text-xs font-bold uppercase hover:underline" onclick="event.stopPropagation()">${senderName}</a>
                             <span class="text-[10px] text-gray-500">${date}</span>
                        </div>
                        <p class="text-gray-300 font-sans text-sm leading-relaxed">${msg.content}</p>
                        ${isNew ? '<div class="absolute top-2 right-2 w-2 h-2 bg-gold-400 rounded-full"></div>' : ''}
                    `;
                    
                    // Mark read on click
                    div.addEventListener('click', async () => {
                         if(isNew) {
                             await client.from('messages').update({ read: true }).eq('id', msg.id);
                             div.classList.remove('bg-white/10', 'border-gold-500/50');
                             div.classList.add('bg-white/5', 'border-white/5');
                             div.querySelector('.absolute')?.remove(); // remove dot
                             
                             // Update counter
                             const newUnread = parseInt(cntEl.innerText) - 1;
                             cntEl.innerText = newUnread > 0 ? newUnread : 0;
                             if(newUnread <= 0) cntEl.classList.add('opacity-0');
                         }
                    });

                    inboxCont.appendChild(div);
                });

            } else {
                inboxSec.classList.add('hidden'); // Hide if empty
            }
        }


        async function loadExamen() {
            const today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD
            
            const { data: entries, error } = await client
