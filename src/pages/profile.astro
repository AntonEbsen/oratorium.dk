        <div id="my-bookmarks" class="grid grid-cols-2 md:grid-cols-4 gap-6 text-left pb-16">
            <!-- Populated by JS -->
        </div>

        <!-- Daily Examen -->
        <div class="border-t border-white/10 pt-16 mb-24">
            <h2 class="text-2xl text-gold-500/80 mb-2 font-serif">Daglig Examen</h2>
            <p class="text-gray-500 text-xs italic mb-8">"Hvor mødte jeg Gud i dag? Hvad er jeg taknemmelig for?"</p>
            
            <div id="examen-container" class="max-w-2xl mx-auto bg-white/5 border border-white/10 rounded p-6 text-left relative">
                <div id="examen-loading" class="text-center text-gray-500 text-xs py-8">Indlæser dagens tanker...</div>
                
                <textarea id="examen-input" class="hidden w-full h-32 bg-black/30 border border-gray-700 rounded p-4 text-gray-300 focus:border-gold-500 outline-none resize-none font-serif leading-relaxed" placeholder="Skriv dine tanker her... (Dette er privat)"></textarea>
                
                <div id="examen-display" class="hidden text-gray-300 font-serif leading-relaxed whitespace-pre-wrap"></div>
                
                <button id="save-examen" class="hidden mt-4 bg-gold-600/20 text-gold-500 border border-gold-500/50 px-6 py-2 rounded uppercase text-xs tracking-widest hover:bg-gold-500 hover:text-black transition-colors">
                    Gem Tanker
                </button>
            </div>
        </div>

        <!-- My Testimony -->
        <div class="border-t border-white/10 pt-16 mb-24">
             <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Mit Vidnesbyrd</h2>
             <div id="my-testimony" class="max-w-2xl mx-auto text-left">
                  <p class="text-gray-600 text-xs text-center italic">Du har ikke delt dit vidnesbyrd endnu.</p>
             </div>
        </div>

         <button onclick="signOut()" class="text-gray-500 hover:text-red-400 text-xs uppercase tracking-widest border border-gray-800 px-6 py-3 rounded hover:border-red-500/50 transition-colors">
            Log Ud
        </button>

        <!-- STAMPS / PASSPORT Section -->
        <div class="border-t border-white/10 pt-16 mb-24 w-full">
             <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Mine Stempler</h2>
             <div id="stamps-container" class="grid grid-cols-2 md:grid-cols-4 gap-4">
                 <p class="text-gray-600 text-xs italic col-span-full">Indlæser passet...</p>
             </div>
        </div>

    </div>

    <div id="edit-modal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-gold-500/30 p-8 rounded max-w-sm w-full relative">
            <button onclick="toggleEdit()" class="absolute top-4 right-4 text-gray-500 hover:text-white"><i class="fa-solid fa-times"></i></button>
            <h3 class="text-gold-500 mb-6 font-serif text-xl">Rediger Profil</h3>
            
            <div class="space-y-4 mb-6">
