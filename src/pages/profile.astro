
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Min Profil | Pilgrimspas</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col items-center pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-2xl px-6 text-center">
        
        <!-- Headers -->
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-2">Pilgrimspas</h1>
        <p id="user-email" class="text-xs text-gray-500 uppercase tracking-widest mb-16 sans">Indlæser...</p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-8 mb-16">
            <div class="p-8 bg-white/5 border border-white/10 rounded">
                <i class="fa-solid fa-fire text-gold-500 text-3xl mb-4"></i>
                <h3 class="text-xl text-white">0 Dage</h3>
                <p class="text-[10px] uppercase text-gray-500 sans tracking-widest mt-2">Bønne Streak</p>
            </div>
            <div class="p-8 bg-white/5 border border-white/10 rounded">
                 <i class="fa-solid fa-calendar text-gold-500 text-3xl mb-4"></i>
                 <h3 id="join-date" class="text-xl text-white">...</h3>
                 <p class="text-[10px] uppercase text-gray-500 sans tracking-widest mt-2">Rejse Startet</p>
            </div>
        </div>

        <!-- My Prayers -->
        <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Min Bønnebog</h2>
        <div id="my-prayers" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
            <p class="text-gray-600 text-xs text-center w-full col-span-2">Indlæser dine bønner...</p>
        </div>

        <button onclick="signOut()" class="text-gray-500 hover:text-red-400 text-xs uppercase tracking-widest border border-gray-800 px-6 py-3 rounded hover:border-red-500/50 transition-colors">
            Log Ud
        </button>

    </div>

    <div id="edit-modal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-gold-500/30 p-8 rounded max-w-sm w-full relative">
            <button onclick="toggleEdit()" class="absolute top-4 right-4 text-gray-500 hover:text-white"><i class="fa-solid fa-times"></i></button>
            <h3 class="text-gold-500 mb-6 font-serif text-xl">Rediger Profil</h3>
            <input id="edit-name" type="text" placeholder="Dit Navn" class="w-full bg-black/50 border border-gray-700 rounded p-3 text-white mb-4 focus:border-gold-500 outline-none">
            <button id="save-btn" class="w-full bg-gold-600/20 text-gold-500 border border-gold-500/50 py-2 rounded uppercase text-xs tracking-widest hover:bg-gold-500 hover:text-black transition-colors">Gem</button>
        </div>
    </div>

    <script>
        import { createClient } from '@supabase/supabase-js';

        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        const client = createClient(SUPABASE_URL, SUPABASE_KEY);
        
        const emailEl = document.getElementById('user-email');
        const joinEl = document.getElementById('join-date');
        const modal = document.getElementById('edit-modal');
        const editNameInp = document.getElementById('edit-name');
        const saveBtn = document.getElementById('save-btn');

        let currentUser = null;

        async function init() {
            const { data: { session } } = await client.auth.getSession();
            
            if (!session) {
                window.location.href = '/login';
                return;
            }
            
            currentUser = session.user;
            
            // Get Profile Data
            const { data: profile } = await client
                .from('profiles')
                .select('*')
                .eq('id', currentUser.id)
                .single();
            
            // Display Info
            const displayName = profile?.username || currentUser.email;
            emailEl.innerHTML = `${displayName} <button onclick="toggleEdit()" class="ml-2 text-gold-500/50 hover:text-gold-500"><i class="fa-solid fa-pen"></i></button>`;
            
            if(profile?.username) editNameInp.value = profile.username;

            // Date
            const dateStr = profile?.created_at || currentUser.created_at;
            if(dateStr) {
                const joined = new Date(dateStr).toLocaleDateString('da-DK', { year: 'numeric', month: 'long' });
                joinEl.innerText = joined;
            } else {
                joinEl.innerText = "Ukendt";
            }

            // Fetch My Prayers
            const { data: myPrayers } = await client
                .from('prayers')
                .select('*')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });
            
            const prayersContainer = document.getElementById('my-prayers');
            if(myPrayers && myPrayers.length > 0) {
                prayersContainer.innerHTML = '';
                myPrayers.forEach(p => {
                    const div = document.createElement('div');
                    div.className = "bg-gray-900/40 p-4 rounded border border-white/5 hover:border-gold-500/20 transition-colors";
                    div.innerHTML = `
                        <p class="text-gray-300 font-serif italic mb-3 text-sm">"${p.content}"</p>
                        <div class="flex items-center gap-2 text-xs text-gold-500">
                             <i class="fa-solid fa-hands-praying"></i> 
                             <span>${p.prayer_count} har bedt</span>
                        </div>
                    `;
                    prayersContainer.appendChild(div);
                });
            } else {
                prayersContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-2 italic">Du har ikke delt nogen bønner endnu.</p>';
            }
        }

        window.toggleEdit = () => {
            modal.classList.toggle('hidden');
        }

        saveBtn.addEventListener('click', async () => {
             const newName = editNameInp.value;
             if(!newName) return;
             
             saveBtn.innerText = "Gemmer...";
             
             // Update Profile
             const { error } = await client
                .from('profiles')
                .update({ username: newName }) // Ensure 'username' coll exists in profiles table
                .eq('id', currentUser.id);

             if(error) {
                 alert("Fejl: " + error.message);
                 if(error.message.includes('row')) {
                     // If row missing, insert it (self-healing for manual users)
                     await client.from('profiles').insert([{ id: currentUser.id, username: newName }]);
                     window.location.reload();
                 }
                 saveBtn.innerText = "Gem";
             } else {
                 window.location.reload();
             }
        });

        window.signOut = async () => {
            await client.auth.signOut();
            window.location.href = '/login';
        }
        
        init();
    </script>
</body>
</html>
