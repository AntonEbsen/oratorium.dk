
---
import '@styles/styles.css';
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Min Profil | Pilgrimspas</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        body { font-family: 'Cinzel', serif; background: #020205; color: #e5e7eb; }
        .sans { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="selection:bg-gold-500/30 min-h-screen flex flex-col items-center pt-32">

    <!-- Nav -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-white/40 hover:text-white transition-colors text-xl flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <div class="w-full max-w-2xl px-6 text-center">
        
        <!-- Headers -->
        <h1 class="text-3xl md:text-5xl text-gold-500 mb-2">Pilgrimspas</h1>
        <p id="user-email" class="text-xs text-gray-500 uppercase tracking-widest mb-16 sans">Indlæser...</p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-8 mb-16">
            <div class="p-8 bg-white/5 border border-white/10 rounded">
                <i class="fa-solid fa-fire text-gold-500 text-3xl mb-4"></i>
                <h3 class="text-xl text-white">0 Dage</h3>
                <p class="text-[10px] uppercase text-gray-500 sans tracking-widest mt-2">Bønne Streak</p>
            </div>
            <div class="p-8 bg-white/5 border border-white/10 rounded">
                 <i class="fa-solid fa-calendar text-gold-500 text-3xl mb-4"></i>
                 <h3 id="join-date" class="text-xl text-white">...</h3>
                 <p class="text-[10px] uppercase text-gray-500 sans tracking-widest mt-2">Rejse Startet</p>
            </div>
        </div>

        <!-- My Prayers -->
        <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Min Bønnebog</h2>
        <div id="my-prayers" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left mb-16">
            <p class="text-gray-600 text-xs text-center w-full col-span-2">Indlæser dine bønner...</p>
        </div>

        <!-- My Intercessions -->
        <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Mine Forbønner <span class="text-xs text-gray-600 align-middle ml-2">(Bønner jeg støtter)</span></h2>
        <div id="my-intercessions" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left mb-16">
            <p class="text-gray-600 text-xs text-center w-full col-span-2">Indlæser forbønner...</p>
        </div>

        <!-- Scriptorium (Saved Books) -->
        <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Scriptorium <span class="text-xs text-gray-600 align-middle ml-2">(Gemte Tekster)</span></h2>
        <div id="my-bookmarks" class="grid grid-cols-2 md:grid-cols-4 gap-6 text-left pb-16">
            <!-- Populated by JS -->
        </div>

        <!-- Daily Examen -->
        <div class="border-t border-white/10 pt-16 mb-24">
            <h2 class="text-2xl text-gold-500/80 mb-2 font-serif">Daglig Examen</h2>
            <p class="text-gray-500 text-xs italic mb-8">"Hvor mødte jeg Gud i dag? Hvad er jeg taknemmelig for?"</p>
            
            <div id="examen-container" class="max-w-2xl mx-auto bg-white/5 border border-white/10 rounded p-6 text-left relative">
                <div id="examen-loading" class="text-center text-gray-500 text-xs py-8">Indlæser dagens tanker...</div>
                
                <textarea id="examen-input" class="hidden w-full h-32 bg-black/30 border border-gray-700 rounded p-4 text-gray-300 focus:border-gold-500 outline-none resize-none font-serif leading-relaxed" placeholder="Skriv dine tanker her... (Dette er privat)"></textarea>
                
                <div id="examen-display" class="hidden text-gray-300 font-serif leading-relaxed whitespace-pre-wrap"></div>
                
                <button id="save-examen" class="hidden mt-4 bg-gold-600/20 text-gold-500 border border-gold-500/50 px-6 py-2 rounded uppercase text-xs tracking-widest hover:bg-gold-500 hover:text-black transition-colors">
                    Gem Tanker
                </button>
            </div>
        </div>

        <!-- My Testimony -->
        <div class="border-t border-white/10 pt-16 mb-24">
             <h2 class="text-2xl text-gold-500/80 mb-6 font-serif">Mit Vidnesbyrd</h2>
             <div id="my-testimony" class="max-w-2xl mx-auto text-left">
                  <p class="text-gray-600 text-xs text-center italic">Du har ikke delt dit vidnesbyrd endnu.</p>
             </div>
        </div>

        <button onclick="signOut()" class="text-gray-500 hover:text-red-400 text-xs uppercase tracking-widest border border-gray-800 px-6 py-3 rounded hover:border-red-500/50 transition-colors">
            Log Ud
        </button>

    </div>

    <div id="edit-modal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-gold-500/30 p-8 rounded max-w-sm w-full relative">
            <button onclick="toggleEdit()" class="absolute top-4 right-4 text-gray-500 hover:text-white"><i class="fa-solid fa-times"></i></button>
            <h3 class="text-gold-500 mb-6 font-serif text-xl">Rediger Profil</h3>
            <input id="edit-name" type="text" placeholder="Dit Navn" class="w-full bg-black/50 border border-gray-700 rounded p-3 text-white mb-4 focus:border-gold-500 outline-none">
            <button id="save-btn" class="w-full bg-gold-600/20 text-gold-500 border border-gold-500/50 py-2 rounded uppercase text-xs tracking-widest hover:bg-gold-500 hover:text-black transition-colors">Gem</button>
        </div>
    </div>

    <script>
        import { createClient } from '@supabase/supabase-js';
        import { libraryBooks } from '../utils/library';

        const SUPABASE_URL = 'https://sdfwawnviylwwlbnwpnj.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkZndhd252aXlsd3dsYm53cG5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkyNzY4MjEsImV4cCI6MjA4NDg1MjgyMX0.oIR0N05DQY6ePfDXVNC0UI9DrLrM-LevsK64ANEJGag';
        const client = createClient(SUPABASE_URL, SUPABASE_KEY);
        
        const emailEl = document.getElementById('user-email');
        const joinEl = document.getElementById('join-date');
        const modal = document.getElementById('edit-modal');
        const editNameInp = document.getElementById('edit-name');
        const saveBtn = document.getElementById('save-btn');
        
        // Examen Elements
        const examenLoading = document.getElementById('examen-loading');
        const examenInput = document.getElementById('examen-input');
        const examenDisplay = document.getElementById('examen-display');
        const saveExamenBtn = document.getElementById('save-examen');

        let currentUser = null;

        async function init() {
            const { data: { session } } = await client.auth.getSession();
            
            if (!session) {
                window.location.href = '/login';
                return;
            }
            
            currentUser = session.user;
            
            // Get Profile Data
            const { data: profile } = await client
                .from('profiles')
                .select('*')
                .eq('id', currentUser.id)
                .single();
            
            // Display Info
            const displayName = profile?.username || currentUser.email;
            emailEl.innerHTML = `${displayName} <button onclick="toggleEdit()" class="ml-2 text-gold-500/50 hover:text-gold-500"><i class="fa-solid fa-pen"></i></button>`;
            
            if(profile?.username) editNameInp.value = profile.username;

            // Date
            const dateStr = profile?.created_at || currentUser.created_at;
            if(dateStr) {
                const joined = new Date(dateStr).toLocaleDateString('da-DK', { year: 'numeric', month: 'long' });
                joinEl.innerText = joined;
            } else {
                joinEl.innerText = "Ukendt";
            }

            // Fetch My Prayers
            const { data: myPrayers } = await client
                .from('prayers')
                .select('*')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });
            
            const prayersContainer = document.getElementById('my-prayers');
            if(myPrayers && myPrayers.length > 0) {
                prayersContainer.innerHTML = '';
                myPrayers.forEach(p => {
                    const div = document.createElement('div');
                    div.className = "bg-gray-900/40 p-4 rounded border border-white/5 hover:border-gold-500/20 transition-colors";
                    div.innerHTML = `
                        <p class="text-gray-300 font-serif italic mb-3 text-sm">"${p.content}"</p>
                        <div class="flex items-center gap-2 text-xs text-gold-500">
                             <i class="fa-solid fa-hands-praying"></i> 
                             <span>${p.prayer_count} har bedt</span>
                        </div>
                    `;
                    prayersContainer.appendChild(div);
                });
            } else {
                prayersContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-2 italic">Du har ikke delt nogen bønner endnu.</p>';
            }

            // Streak & Join Date Logic
            const streakEl = document.querySelector('h3.text-xl.text-white'); // The first h3 is streak
            if(streakEl && profile?.streak !== undefined) {
                streakEl.innerText = profile.streak + " Dage";
                // If streak > 0, make fire icon glow
                if(profile.streak > 0) {
                    const fireIcon = document.querySelector('.fa-fire');
                    fireIcon?.classList.add('text-orange-500', 'animate-pulse');
                    fireIcon?.classList.remove('text-gold-500');
                }
            }

            // Fetch Intercessions (Joined Query)
            const { data: intercessions } = await client
                .from('prayer_interactions')
                .select('prayer_id, prayers(content, author)')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });

            const intContainer = document.getElementById('my-intercessions');
            if(intercessions && intercessions.length > 0) {
                intContainer.innerHTML = '';
                intercessions.forEach(int => {
                    // Supabase join returns nested object or array depending on relation type,
                    // but here it is Many-to-One so 'prayers' is object usually? No, it's singular if FK properly set.
                    // Actually, TypeScript usually warns, but JS is loose. 
                    // Let's handle 'prayers' as object.
                    const p = int.prayers; 
                    if(p) { // Check if prayer still exists
                        const div = document.createElement('div');
                        div.className = "bg-white/5 p-4 rounded border border-white/5 opacity-80 hover:opacity-100 transition-opacity";
                        div.innerHTML = `
                            <p class="text-gray-400 font-serif italic mb-2 text-xs">"${p.content}"</p>
                            <p class="text-[9px] uppercase tracking-widest text-gold-500/60">- ${p.author || 'Anonym'}</p>
                        `;
                        intContainer.appendChild(div);
                    }
                });
            } else {
                 intContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-2 italic">Du har ikke bedt for nogen endnu. Besøg Forbønsmuren.</p>';
            }

            // Fetch Bookmarks
            const { data: bookmarks } = await client
                .from('bookmarks')
                .select('book_id')
                .eq('user_id', currentUser.id);

            const marksContainer = document.getElementById('my-bookmarks');
            if(bookmarks && bookmarks.length > 0) {
                marksContainer.innerHTML = '';
                bookmarks.forEach(bm => {
                    const book = libraryBooks.find(b => b.id === bm.book_id);
                    if(book) {
                         const div = document.createElement('div');
                         // Mini Book Card
                         div.className = `relative h-40 w-full rounded shadow-md overflow-hidden ${book.coverColor} group cursor-pointer`;
                         div.innerHTML = `
                             <div class="absolute inset-0 opacity-20 mix-blend-multiply bg-black"></div>
                             <div class="absolute left-0 top-0 bottom-0 w-4 bg-black/20 border-r border-white/5"></div>
                             <div class="absolute top-4 left-6 right-2">
                                <h4 class="text-gold-100 text-xs font-bold leading-tight line-clamp-2">${book.title}</h4>
                                <p class="text-gold-500/80 text-[10px] uppercase mt-1">${book.author}</p>
                             </div>
                         `;
                         // Optional: Link to... where? For now just visual.
                         marksContainer.appendChild(div);
                    }
                });
            } else {
                marksContainer.innerHTML = '<p class="text-gray-600 text-xs text-center w-full col-span-4 italic">Dit Scriptorium er tomt. Besøg biblioteket for at samle visdom.</p>';
            }

            // Examen Logic
            loadExamen();

            // Testimony Logic
            const { data: testies } = await client
                .from('testimonies')
                .select('*')
                .eq('user_id', currentUser.id)
                .order('created_at', { ascending: false });

            const testContainer = document.getElementById('my-testimony');
            if(testies && testies.length > 0) {
                 const t = testies[0]; // Latest
                 let statusHtml = '';
                 if(t.approved) {
                     statusHtml = '<span class="text-green-500 text-xs uppercase tracking-widest border border-green-500/30 px-2 py-1 rounded">Godkendt</span>';
                 } else {
                     statusHtml = '<span class="text-yellow-500 text-xs uppercase tracking-widest border border-yellow-500/30 px-2 py-1 rounded">Afventer Godkendelse</span>';
                 }

                 testContainer.innerHTML = `
                    <div class="bg-white/5 p-6 rounded border border-white/10">
                        <div class="flex justify-between items-start mb-4">
                            <h4 class="text-gold-200 font-serif text-lg">"${t.name}"</h4>
                            ${statusHtml}
                        </div>
                        <p class="text-gray-400 font-serif italic text-sm leading-relaxed mb-4 whitespace-pre-wrap">${t.content}</p>
                        <p class="text-[10px] text-gray-600 uppercase tracking-widest">${new Date(t.created_at).toLocaleDateString()}</p>
                    </div>
                 `;
            }
        }

        async function loadExamen() {
            const today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD
            
            const { data: entries, error } = await client
                .from('daily_examens')
                .select('*')
                .eq('user_id', currentUser.id)
                .eq('date', today)
                .maybeSingle();

            examenLoading.classList.add('hidden');
            
            if(entries) {
                // Already written today
                examenDisplay.innerText = entries.content;
                examenDisplay.classList.remove('hidden');
                // Could add edit button later
            } else {
                // Not written yet
                examenInput.classList.remove('hidden');
                saveExamenBtn.classList.remove('hidden');
            }
        }

        saveExamenBtn.addEventListener('click', async () => {
             const content = (examenInput as HTMLTextAreaElement).value;
             if(!content.trim()) return;
             
             saveExamenBtn.innerText = "Gemmer...";
             
             const today = new Date().toISOString().split('T')[0];

             const { error } = await client.from('daily_examens').insert([
                 { user_id: currentUser.id, content: content, date: today }
             ]);
             
             if(error) {
                 alert("Fejl: " + error.message);
                 saveExamenBtn.innerText = "Gem Tanker";
             } else {
                 // Switch to display mode
                 examenInput.classList.add('hidden');
                 saveExamenBtn.classList.add('hidden');
                 examenDisplay.innerText = content;
                 examenDisplay.classList.remove('hidden');
             }
        });

        window.toggleEdit = () => {
            modal.classList.toggle('hidden');
        }

        saveBtn.addEventListener('click', async () => {
             const newName = editNameInp.value;
             if(!newName) return;
             
             saveBtn.innerText = "Gemmer...";
             
             // Update Profile
             const { error } = await client
                .from('profiles')
                .update({ username: newName }) // Ensure 'username' coll exists in profiles table
                .eq('id', currentUser.id);

             if(error) {
                 alert("Fejl: " + error.message);
                 if(error.message.includes('row')) {
                     // If row missing, insert it (self-healing for manual users)
                     await client.from('profiles').insert([{ id: currentUser.id, username: newName }]);
                     window.location.reload();
                 }
                 saveBtn.innerText = "Gem";
             } else {
                 window.location.reload();
             }
        });

        window.signOut = async () => {
            await client.auth.signOut();
            window.location.href = '/login';
        }
        
        init();
    </script>
</body>
</html>
