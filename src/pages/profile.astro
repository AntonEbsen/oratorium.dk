            <div class="p-8 bg-white/5 border border-white/10 rounded">
                 <i class="fa-solid fa-calendar text-gold-500 text-3xl mb-4"></i>
                 <h3 id="join-date" class="text-xl text-white">...</h3>
                 <p class="text--[10px] uppercase text-gray-500 sans tracking-widest mt-2">Rejse Startet</p>
            </div>
        </div>

        <!-- Inbox -->
        <div id="inbox-section" class="mb-16 hidden">
            <h2 class="text-2xl text-gold-500/80 mb-6 font-serif flex items-center justify-between">
                <div>Postkasse <span id="msg-count" class="bg-red-600 text-white text-[10px] px-2 py-1 rounded-full align-middle ml-2 opacity-0">0</span></div>
            </h2>
            <div id="inbox-container" class="space-y-3">
