---
import Layout from '@layouts/Layout.astro';
---

<Layout
    fullscreen
    title="Rosenkransen | Ad Majorem Dei Gloriam"
    noindex
    bodyClass="bg-[#050508] text-gray-300 overflow-hidden h-screen w-screen m-0 p-0 selection:bg-gold-500/30"
>

<style is:global>
body { font-family: 'Cinzel', serif; }
        .sans { font-family: 'Inter', sans-serif; }
</style>
    <!-- Background -->
    <div class="fixed inset-0 z-0 pointer-events-none bg-gradient-to-b from-[#020205] via-[#0a0a1a] to-black">
         <div class="absolute inset-0 opacity-10" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png');"></div>
         <!-- Glow -->
         <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gold-500/5 rounded-full blur-[100px] animate-pulse-slow"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-8 left-8 z-50">
        <a href="/" class="text-gold-500/60 hover:text-gold-400 transition-colors text-xl flex items-center gap-2 sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="text-xs uppercase tracking-widest hidden md:inline">Tilbage</span>
        </a>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 w-full h-full flex flex-col items-center justify-center">
        
        <!-- Prayer Text Display -->
        <div class="text-center mb-16 h-48 flex flex-col items-center justify-center p-4">
            <h2 id="prayer-title" class="text-gold-400 text-xl tracking-[0.2em] uppercase mb-4 animate-fade-in">In Nomine Patris</h2>
            <p id="prayer-text" class="text-lg md:text-2xl text-gray-300 max-w-2xl leading-relaxed italic animate-fade-in delay-100">
                In nomine Patris, et Filii, et Spiritus Sancti. Amen.
            </p>
        </div>

        <!-- The Rosary Beads (Visual Representation) -->
        <div class="relative w-64 h-64 md:w-80 md:h-80 border-2 border-gold-500/20 rounded-full flex items-center justify-center mb-12">
            
            <!-- Center Cross -->
            <div class="absolute bottom-[-40px] text-gold-500 text-3xl drop-shadow-[0_0_10px_rgba(255,215,0,0.5)]">
                <i class="fa-solid fa-cross"></i>
            </div>
            
             <!-- AUDIO CONTROLS (Floating top) -->
            <button id="play-btn" class="absolute -top-16 px-6 py-2 bg-gold-500/10 hover:bg-gold-500/20 border border-gold-500/30 rounded-full text-xs uppercase tracking-widest text-gold-500 transition-all z-20">
                <i class="fa-solid fa-play mr-2"></i> Bed for mig
            </button>

            <!-- Interactive Bead Area -->
            <button id="next-bead" class="group relative px-8 py-4 bg-gold-900/10 hover:bg-gold-500/10 border border-gold-500/30 rounded-full transition-all active:scale-95">
                <span class="text-sm sans uppercase tracking-widest text-gold-400 group-hover:text-gold-200">
                    Næste Bøn <i class="fa-solid fa-chevron-right ml-2 text-xs"></i>
                </span>
                <!-- Ripple effect on click handled by JS/CSS active -->
            </button>
            
            <!-- Progress Indicator -->
            <div class="absolute -bottom-16 text-xs sans text-gray-500 uppercase tracking-widest">
                <span id="counter">0</span> / 53
            </div>

        </div>

        <!-- Mystery Selector -->
        <div class="flex gap-4 opacity-50 hover:opacity-100 transition-opacity">
            <button class="mystery-btn text-xs sans uppercase tracking-widest text-gold-500 border-b border-transparent hover:border-gold-500" data-mystery="joyful">Glædens</button>
            <button class="mystery-btn text-xs sans uppercase tracking-widest text-gray-500 hover:text-gold-500 border-b border-transparent hover:border-gold-500" data-mystery="sorrowful">Smertens</button>
            <button class="mystery-btn text-xs sans uppercase tracking-widest text-gray-500 hover:text-gold-500 border-b border-transparent hover:border-gold-500" data-mystery="glorious">Herlighedens</button>
        </div>

    </main>

    <style>
        .animate-fade-in {
            animation: fadeIn 1s ease-out forwards;
            opacity: 0;
        }
        @keyframes fadeIn {
            to { opacity: 1; }
        }
        .delay-100 { animation-delay: 0.1s; }
        
        .animate-pulse-slow {
            animation: pulse 8s infinite ease-in-out;
        }
    </style>

    <script>
        // Data: Prayers with Spoken Text (Danish)
        const prayers = [
            { 
                title: "Signum Crucis", 
                text: "In nomine Patris, et Filii, et Spiritus Sancti. Amen.",
                spoken: "I Faderens og Sønnens og Helligåndens navn. Amen."
            },
            { 
                title: "Symbolum Apostolorum", 
                text: "Credo in Deum Patrem omnipotentem, Creatorem caeli et terrae...",
                spoken: "Jeg tror på Gud Fader, den Almægtige, himlens og jordens skaber."
            },
            { 
                title: "Pater Noster", 
                text: "Pater noster, qui es in caelis, sanctificetur nomen tuum...",
                spoken: "Fader vor, du som er i himlene. Helliget vorde dit navn. Komme dit rige."
            },
            { 
                title: "Ave Maria", 
                text: "Ave Maria, gratia plena, Dominus tecum...",
                spoken: "Hil dig, Maria, fuld af nåde. Herren er med dig."
            },
            { 
                title: "Ave Maria", 
                text: "Ave Maria, gratia plena, Dominus tecum...",
                spoken: "Hil dig, Maria, fuld af nåde. Herren er med dig."
            },
            { 
                title: "Ave Maria", 
                text: "Ave Maria, gratia plena, Dominus tecum...",
                spoken: "Hil dig, Maria, fuld af nåde. Herren er med dig."
            },
            { 
                title: "Gloria Patri", 
                text: "Gloria Patri, et Filio, et Spiritui Sancto...",
                spoken: "Ære være Faderen og Sønnen og Helligånden."
            },
            // In a real app, we would generate the full 53 beads here
        ];

        // Supabase
import { supabase as client } from '@lib/supabaseClient';

        let currentIndex = 0;
        let totalBeads = 53; 
        
        const titleEl = document.getElementById('prayer-title');
        const textEl = document.getElementById('prayer-text');
        const counterEl = document.getElementById('counter');
        const btn = document.getElementById('next-bead');
        
        // Audio Logic
        const audioToggle = document.getElementById('audio-toggle');
        const playBtn = document.getElementById('play-btn');
        let isAutoMode = false;
        let isSpeaking = false;
        const synth = window.speechSynthesis;

        // Init UI
        updateDisplay();

        // Handlers
        btn?.addEventListener('click', nextBead);
        
        // Play / Pause Auto Mode
        playBtn?.addEventListener('click', () => {
            if(isSpeaking) {
                // Stop/Pause
                synth.cancel();
                isSpeaking = false;
                playBtn.innerHTML = '<i class="fa-solid fa-play mr-2"></i> Bed for mig';
                playBtn.classList.remove('bg-red-500/20', 'text-red-400');
                playBtn.classList.add('bg-gold-500/10', 'text-gold-500');
            } else {
                // Start
                isSpeaking = true;
                playBtn.innerHTML = '<i class="fa-solid fa-stop mr-2"></i> Stop Bøn';
                playBtn.classList.remove('bg-gold-500/10', 'text-gold-500');
                playBtn.classList.add('bg-red-500/20', 'text-red-400');
                speakCurrent();
            }
        });

        function nextBead() {
            // If manual click during auto-mode, ignore or stop? Let's just advance.
            currentIndex++;
            if(currentIndex > totalBeads) currentIndex = 1;
            
            updateDisplay();
            
            if(currentIndex === totalBeads) {
                finishRosary();
                return;
            }

            if(isSpeaking) {
                speakCurrent();
            }
        }

        function speakCurrent() {
            synth.cancel(); // Stop previous
            const pIndex = currentIndex % prayers.length;
            const textToSpeak = prayers[pIndex].spoken;

            const utterance = new SpeechSynthesisUtterance(textToSpeak);
            utterance.lang = 'da-DK'; // Danish
            utterance.rate = 0.9; // Slightly slower/reverent
            
            utterance.onend = () => {
                // Auto-advance after small pause
                setTimeout(() => {
                    if(isSpeaking) nextBead();
                }, 1000);
            };

            synth.speak(utterance);
        }

        function updateDisplay() {
            if(!titleEl || !textEl || !counterEl) return;
            
            const pIndex = currentIndex % prayers.length;
            
            titleEl.style.opacity = '0';
            textEl.style.opacity = '0';

            setTimeout(() => {
                titleEl.innerText = prayers[pIndex].title;
                textEl.innerText = prayers[pIndex].text;
                counterEl.innerText = currentIndex.toString();
                
                titleEl.classList.remove('animate-fade-in');
                void titleEl.offsetWidth; 
                titleEl.classList.add('animate-fade-in');
                titleEl.style.opacity = '1';

                textEl.classList.remove('animate-fade-in');
                void textEl.offsetWidth; 
                textEl.classList.add('animate-fade-in');
                textEl.style.opacity = '1';
            }, 300);
        }

        async function finishRosary() {
            synth.cancel();
            isSpeaking = false;
            
            const { data: { session } } = await client.auth.getSession();
            if(!session) {
                alert("Rosenkrans fuldført!");
                return;
            }

            const finishMsg = document.createElement('div');
            finishMsg.className = "fixed inset-0 bg-black/90 z-50 flex flex-col items-center justify-center animate-fade-in";
            finishMsg.innerHTML = `
                <i class="fa-solid fa-rose text-6xl text-red-600 mb-6 drop-shadow-[0_0_30px_rgba(220,20,60,0.5)]"></i>
                <h2 class="text-3xl text-gold-500 font-serif mb-4">Rosenkrans Fuldført</h2>
                <div class="text-white text-sm">Gemmer din bøn...</div>
            `;
            document.body.appendChild(finishMsg);

            const { data: profile } = await client.from('profiles').select('rosary_count').eq('id', session.user.id).single();
            const newCount = (profile?.rosary_count || 0) + 1;
            
            await client.from('profiles').update({ rosary_count: newCount }).eq('id', session.user.id);
            
            setTimeout(() => {
                finishMsg.innerHTML += `<div class="mt-8 text-green-400 uppercase tracking-widest text-xs">Gemt!</div>`;
                setTimeout(() => {
                    window.location.href = '/profile';
                }, 1500);
            }, 1000);
        }
    </script>
</Layout>
