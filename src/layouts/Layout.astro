---
// Shared page shell. Wraps every page with the <head> (via BaseHead) and a
// <body> carrying the site's base typography. Pages pass SEO props through and
// can inject page-specific <link>/<style> into <head> via the "head" slot.
import '@styles/styles.css';
import BaseHead from '@components/BaseHead.astro';

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    extraFonts?: string[];
    ogType?: string;
    noindex?: boolean;
    /** Extra classes for <body> (e.g. layout/scroll modifiers per page). */
    bodyClass?: string;
    /** Optional id for <body> (some pages' scripts target it). */
    bodyId?: string;
    lang?: string;
}

const {
    title,
    description,
    image,
    extraFonts,
    ogType,
    noindex,
    bodyClass = '',
    bodyId,
    lang = 'da',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            extraFonts={extraFonts}
            ogType={ogType}
            noindex={noindex}
        />
        <slot name="head" />
    </head>
    <body id={bodyId} class:list={['selection:bg-gold-500/30', bodyClass]}>
        <slot />
    </body>
</html>

<style is:global>
    /* Defaults via element selector (low specificity) so a page's own
       background or text utility in bodyClass overrides them deterministically. */
    body {
        background-color: #020205;
        color: #e5e7eb;
        font-family: 'Cinzel', serif;
    }
    .sans {
        font-family: 'Inter', sans-serif;
    }
    html {
        scroll-behavior: smooth;
    }
</style>
