---
// Shared page shell. Wraps every page with the <head> (via BaseHead) and a
// <body> carrying the site's base typography. Pages pass SEO props through and
// can inject page-specific <link>/<style> into <head> via the "head" slot.
import '@styles/styles.css';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';

// Self-hosted fonts (replaces the Google Fonts CDN) + Font Awesome (replaces cdnjs).
// @font-face CSS is global, but each woff2 is fetched only on pages that use it.
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/crimson-text/400.css';
import '@fontsource/crimson-text/600.css';
import '@fontsource/crimson-text/400-italic.css';
import '@fontsource/unifrakturmaguntia/400.css';
import '@fontsource/nanum-myeongjo/400.css';
import '@fontsource/nanum-myeongjo/700.css';
import '@fortawesome/fontawesome-free/css/all.min.css';

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    extraFonts?: string[];
    ogType?: string;
    noindex?: boolean;
    /** Extra classes for <body> (e.g. layout/scroll modifiers per page). */
    bodyClass?: string;
    /** Optional id for <body> (some pages' scripts target it). */
    bodyId?: string;
    /** Skip the shared footer on immersive full-screen pages. */
    fullscreen?: boolean;
    lang?: string;
}

const {
    title,
    description,
    image,
    extraFonts,
    ogType,
    noindex,
    bodyClass = '',
    bodyId,
    fullscreen = false,
    lang = 'da',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            extraFonts={extraFonts}
            ogType={ogType}
            noindex={noindex}
        />
        <slot name="head" />
    </head>
    <body id={bodyId} class:list={['selection:bg-gold-500/30', bodyClass]}>
        <a href="#hovedindhold" class="skip-link sans">Spring til indhold</a>
        <slot />
        {!fullscreen && <Footer />}
        <script is:inline>
            (() => {
                const m = document.querySelector('main');
                const sk = document.querySelector('.skip-link');
                if (m) {
                    if (!m.id) m.id = 'hovedindhold';
                    m.setAttribute('tabindex', '-1');
                    if (sk) sk.setAttribute('href', '#' + m.id);
                } else if (sk) {
                    sk.remove();
                }
            })();
        </script>
    </body>
</html>

<style is:global>
    /* Defaults via element selector (low specificity) so a page's own
       background or text utility in bodyClass overrides them deterministically. */
    body {
        background-color: #020205;
        color: #e5e7eb;
        font-family: 'Cinzel', serif;
    }
    .sans {
        font-family: 'Inter', sans-serif;
    }
    html {
        scroll-behavior: smooth;
    }

    :focus-visible {
        outline: 2px solid #d4af37;
        outline-offset: 2px;
        border-radius: 2px;
    }

    .skip-link {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        transform: translateY(-130%);
        background: #d4af37;
        color: #000;
        padding: 0.7rem 1.2rem;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: transform 0.2s ease;
    }
    .skip-link:focus {
        transform: translateY(0);
    }

    /* Respect users who prefer reduced motion — neutralize the site's
       many ambient animations/transitions. */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.001ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.001ms !important;
        }
        html {
            scroll-behavior: auto !important;
        }
    }
</style>
