---
// Single source of truth for <head>: meta, PWA, SEO, service worker.
// Fonts + Font Awesome are self-hosted and imported globally in Layout.astro.
export interface Props {
    title?: string;
    description?: string;
    /** Path or absolute URL to the social share image. */
    image?: string;
    /** Deprecated: fonts are now self-hosted globally; kept for back-compat. */
    extraFonts?: string[];
    /** Open Graph type, e.g. "website" or "article". */
    ogType?: string;
    noindex?: boolean;
}

const SITE = Astro.site ?? new URL('https://oratorium.dk');
const {
    title = 'Oratorium | Det Digitale Kapel',
    description = 'Oratorium.dk – Den Katolske Kirkes digitale forgård. Find messetider, lær om troen, bed rosenkransen og find vejen hjem.',
    image = '/assets/monstrance.png',
    ogType = 'website',
    noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />

<!-- PWA / App -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#020205" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Oratorium" />
<meta property="og:locale" content="da_DK" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Service Worker -->
<script is:inline>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
</script>
