---
// Single source of truth for <head>: meta, fonts, PWA, SEO, service worker.
// Pages set page-specific fonts via the `extraFonts` prop and inject any extra
// head markup through the named "head" slot exposed by Layout.astro.
export interface Props {
    title?: string;
    description?: string;
    /** Path or absolute URL to the social share image. */
    image?: string;
    /** Extra Google Fonts family specifiers, e.g. "Playfair+Display:wght@400;700". */
    extraFonts?: string[];
    /** Open Graph type, e.g. "website" or "article". */
    ogType?: string;
    noindex?: boolean;
}

const SITE = Astro.site ?? new URL('https://oratorium.dk');
const {
    title = 'Oratorium | Det Digitale Kapel',
    description = 'Oratorium.dk – Den Katolske Kirkes digitale forgård. Find messetider, lær om troen, bed rosenkransen og find vejen hjem.',
    image = '/assets/monstrance.png',
    extraFonts = [],
    ogType = 'website',
    noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;

// Cinzel + Inter are loaded on every page; pages opt into the rest.
const baseFonts = ['Cinzel:wght@400;700', 'Inter:wght@300;400;600'];
const fontQuery = [...baseFonts, ...extraFonts].map((f) => `family=${f}`).join('&');
const fontsHref = `https://fonts.googleapis.com/css2?${fontQuery}&display=swap`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />

<!-- PWA / App -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#020205" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="icon" type="image/svg+xml" href="/assets/favicon-cross.svg" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Oratorium" />
<meta property="og:locale" content="da_DK" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={fontsHref} rel="stylesheet" />
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
/>

<!-- Service Worker -->
<script is:inline>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
</script>
